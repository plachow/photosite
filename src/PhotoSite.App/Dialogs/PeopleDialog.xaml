<Window x:Class="PhotoSite.Dialogs.PeopleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infrastructure="clr-namespace:PhotoSite.Infrastructure"
        Title="People"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        Background="{DynamicResource WindowBrush}"
        Foreground="#F2F4F8"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <infrastructure:PersonBrushConverter x:Key="PersonBrush" />
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Named people -->
      <Border Margin="0,0,12,0" Style="{StaticResource DialogPanelStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="PEOPLE" />
          <ListBox x:Name="PeopleList"
                   Grid.Row="1"
                   ItemContainerStyle="{StaticResource PanelListBoxItemStyle}"
                   SelectionChanged="OnPeopleSelectionChanged" />
          <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Margin="0,0,0,4"
                    Content="Rename…"
                    Click="OnRenamePersonClick" />
            <Button Content="Remove person"
                    ToolTip="Faces return to the unnamed groups; keywords already written into files stay."
                    Click="OnDeletePersonClick" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Scan, suggestions and unnamed groups -->
      <Border Grid.Column="1" Style="{StaticResource DialogPanelStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Style="{StaticResource SectionHeaderStyle}"
                     Text="SCAN" />
          <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ScanButton"
                    MinWidth="170"
                    Content="Scan folder for faces"
                    Click="OnScanClick" />
            <ProgressBar x:Name="ScanProgress"
                         Grid.Column="1"
                         Margin="10,0,0,0"
                         Visibility="Collapsed" />
          </Grid>
          <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="SummaryText"
                       FontSize="13"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <!-- Corrective editing: the faces of the selected person, each
                   removable when the match was wrong. -->
              <TextBlock x:Name="PersonFacesHeader"
                         Style="{StaticResource SectionHeaderStyle}"
                         Visibility="Collapsed" />
              <ItemsControl x:Name="PersonFacesList" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,6,6">
                      <Border Width="64"
                              Height="64"
                              Background="#111318"
                              CornerRadius="4"
                              ToolTip="{Binding Face.Path}">
                        <Image Margin="2"
                               Source="{Binding Thumbnail}"
                               Stretch="UniformToFill" />
                      </Border>
                      <Button Width="18"
                              Height="18"
                              Margin="0,2,2,0"
                              Padding="0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              AutomationProperties.Name="Remove this face from the person"
                              Content="✕"
                              FontSize="10"
                              Tag="{Binding}"
                              ToolTip="Not them - remove this face from the person"
                              Click="OnUnassignFaceClick" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="SuggestionsHeader"
                         Style="{StaticResource SectionHeaderStyle}"
                         Text="IS THIS THEM?"
                         Visibility="Collapsed" />
              <ItemsControl x:Name="SuggestionList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,6,8"
                            Padding="10"
                            Background="#2A2620"
                            BorderBrush="#54492F"
                            BorderThickness="1"
                            CornerRadius="5">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <ItemsControl ItemsSource="{Binding Thumbnails}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Width="64"
                                        Height="64"
                                        Margin="0,0,6,0"
                                        Background="#111318"
                                        CornerRadius="4">
                                  <Image Margin="2"
                                         Source="{Binding}"
                                         Stretch="UniformToFill" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Margin="0,6,0,0"
                                     FontSize="12"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     Text="{Binding QuestionText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                          <Button MinWidth="130"
                                  Content="Yes, it is"
                                  Tag="{Binding}"
                                  Click="OnConfirmSuggestionClick" />
                          <Button MinWidth="130"
                                  Margin="0,6,0,0"
                                  Content="No, someone else"
                                  Tag="{Binding}"
                                  Click="OnRejectSuggestionClick" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Style="{StaticResource SectionHeaderStyle}"
                         Text="UNNAMED GROUPS" />
              <ItemsControl x:Name="ClusterList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,6,8"
                          Padding="10"
                          Background="#20242B"
                          BorderBrush="#3A3F4B"
                          BorderThickness="1"
                          CornerRadius="5">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Thumbnails}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Width="64"
                                      Height="64"
                                      Margin="0,0,6,0"
                                      Background="#111318"
                                      CornerRadius="4">
                                <Image Margin="2"
                                       Source="{Binding}"
                                       Stretch="UniformToFill" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding CountText}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Margin="12,0,0,0"
                                  MaxWidth="250"
                                  VerticalAlignment="Center">
                        <!-- One click on a chip tags the whole group. -->
                        <ItemsControl ItemsSource="{Binding AssignChoices}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Style="{StaticResource PersonChipButtonStyle}"
                                      Tag="{Binding}"
                                      Click="OnAssignChipClick">
                                <StackPanel Orientation="Horizontal">
                                  <Ellipse Width="8"
                                           Height="8"
                                           Margin="0,1,5,0"
                                           VerticalAlignment="Center"
                                           Fill="{Binding Person,
                                                          Converter={StaticResource PersonBrush}}" />
                                  <TextBlock FontSize="11"
                                             Text="{Binding Person.Name}" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                          <Button Content="＋ New person…"
                                  Tag="{Binding}"
                                  Click="OnAssignNewPersonClick" />
                          <Button Margin="6,0,0,0"
                                  Style="{StaticResource PersonChipButtonStyle}"
                                  AutomationProperties.Name="Ignore this group"
                                  Tag="{Binding}"
                                  ToolTip="Strangers - hide this group and never offer these faces again"
                                  Click="OnIgnoreClusterClick">
                            <TextBlock FontSize="11" Text="🚫 Ignore" />
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="1"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button x:Name="CloseButton"
              MinWidth="96"
              Content="Close"
              IsCancel="True"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
