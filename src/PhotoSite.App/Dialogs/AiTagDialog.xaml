<Window x:Class="PhotoSite.Dialogs.AiTagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Describe with AI"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="RowLabel"
           TargetType="TextBlock"
           BasedOn="{StaticResource FieldLabelStyle}">
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource DialogPanelStyle}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                   Text="OLLAMA SERVER" />
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource RowLabel}" Text="Server" />
          <TextBox x:Name="EndpointBox"
                   Grid.Column="1"
                   TextChanged="OnSettingChanged" />
          <Button Grid.Column="2"
                  MinWidth="120"
                  Margin="8,0,0,0"
                  Content="Refresh models"
                  Click="OnRefreshModelsClick" />
        </Grid>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource RowLabel}" Text="Model" />
          <ComboBox x:Name="ModelBox"
                    Grid.Column="1"
                    IsEditable="True"
                    SelectionChanged="OnSettingChanged" />
        </Grid>

        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                   Text="WHAT TO WRITE" />
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource RowLabel}" Text="Language" />
          <ComboBox x:Name="LanguageBox"
                    Grid.Column="1"
                    Width="150"
                    SelectionChanged="OnSettingChanged" />
          <TextBlock Grid.Column="2"
                     Margin="18,0,10,0"
                     Style="{StaticResource RowLabel}"
                     Text="Existing metadata" />
          <ComboBox x:Name="ApplyModeBox"
                    Grid.Column="3"
                    SelectionChanged="OnSettingChanged" />
        </Grid>
        <TextBlock Margin="0,0,0,10"
                   FontSize="11"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="The model fills the title, the description and the keywords, written into the catalogue and into the photo files. Keywords are always merged with the ones already on the photo. When the language is not English, an English description is stored in the catalogue as well, so search works in both languages."
                   TextWrapping="Wrap" />

        <Border Padding="12,10"
                Background="#20242B"
                BorderBrush="#3A3F4B"
                BorderThickness="1"
                CornerRadius="5">
          <StackPanel>
            <TextBlock x:Name="SummaryText"
                       FontSize="13"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText"
                       Margin="0,5,0,0"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="RunProgress"
                         Margin="0,9,0,0"
                         Visibility="Collapsed" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button x:Name="RunButton"
              MinWidth="132"
              Content="Describe"
              IsDefault="True"
              Click="OnRunClick" />
      <Button x:Name="CloseButton"
              MinWidth="96"
              Margin="8,0,0,0"
              Content="Close"
              IsCancel="True"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
