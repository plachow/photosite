<Window x:Class="PhotoSite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PhotoSite.Controls"
        xmlns:infrastructure="clr-namespace:PhotoSite.Infrastructure"
        xmlns:viewModels="clr-namespace:PhotoSite.ViewModels"
        Title="PhotoSite"
        Icon="{StaticResource AppIcon}"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <infrastructure:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <infrastructure:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <infrastructure:EnumEqualsConverter x:Key="EnumEquals" />
    <infrastructure:SortFieldNameConverter x:Key="SortFieldName" />
    <infrastructure:ActiveEditorTabConverter x:Key="ActiveEditorTab" />
    <infrastructure:PersonBrushConverter x:Key="PersonBrush" />

    <!-- A person as a small pill: their colour dot and name. -->
    <DataTemplate x:Key="PersonBadgeTemplate">
      <Border Margin="0,2,4,0"
              Padding="6,2,7,3"
              Background="#242832"
              BorderBrush="#3A3F4B"
              BorderThickness="1"
              CornerRadius="9">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8"
                   Height="8"
                   Margin="0,1,5,0"
                   VerticalAlignment="Center"
                   Fill="{Binding Converter={StaticResource PersonBrush}}" />
          <TextBlock FontSize="11"
                     Foreground="#E8ECF2"
                     Text="{Binding Name}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Tab strip: one Manager tab, one tab per open editor. -->
    <Style x:Key="TabLabelButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#C8CDD8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TabCloseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TabLabelButtonStyle}">
      <Setter Property="Padding" Value="6,6,10,6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#79808D" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#FF9A9A" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="EditorTabStyle" TargetType="Border">
      <Setter Property="Background" Value="#1D2129" />
      <Setter Property="BorderBrush" Value="#303541" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="CornerRadius" Value="6,6,0,0" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style x:Key="NavigationButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="BreadcrumbButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Foreground" Value="#C8CDD8" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="InfoCaptionStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#79808D" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="InfoValueStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E4E7ED" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="EditorToolButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="17" />
    </Style>

    <Style x:Key="EditorResetButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource EditorToolButtonStyle}">
      <Setter Property="Width" Value="Auto" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="EditorActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource EditorResetButtonStyle}">
      <Setter Property="MinWidth" Value="56" />
    </Style>

    <Style x:Key="GalleryToolButtonStyle"
           TargetType="ToggleButton"
           BasedOn="{StaticResource EditorSelectToggleButtonStyle}">
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- The ˄ / ˅ steppers riding on the info-pane split bars. -->
    <Style x:Key="SplitBarChevronButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Foreground" Value="#9299A7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="0,-1,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#3E4656" />
          <Setter Property="Foreground" Value="#F2F4F8" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#555B66" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PhotoContextMenuStyle"
           TargetType="ContextMenu">
      <Setter Property="Padding" Value="3" />
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="#4A5160" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F2F4F8" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
              <ItemsPresenter Margin="{TemplateBinding Padding}"
                              KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PhotoContextMenuItemStyle"
           TargetType="MenuItem">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="Foreground" Value="#F2F4F8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemBorder"
                    MinWidth="280"
                    Height="34"
                    Background="{TemplateBinding Background}"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  ContentSource="Icon" />
                <ContentPresenter Grid.Column="1"
                                  Margin="3,0,12,0"
                                  VerticalAlignment="Center"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="#AAB2C0"
                           Text="{TemplateBinding InputGestureText}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder"
                        Property="Background"
                        Value="#315676" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PhotoContextMenuSeparatorStyle"
           TargetType="Separator">
      <Setter Property="Height" Value="9" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1"
                    VerticalAlignment="Center"
                    Background="#4A5160"
                    SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <ContextMenu x:Key="PhotoFileContextMenu"
                 Style="{StaticResource PhotoContextMenuStyle}"
                 DataContext="{Binding PlacementTarget.Tag,
                                       RelativeSource={RelativeSource Self}}"
                 Opened="OnPhotoFileContextMenuOpened">
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Open in Editor"
                Click="OnOpenInEditorClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="17"
                     Foreground="#8BC8FF"
                     Text="✎" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator Style="{StaticResource PhotoContextMenuSeparatorStyle}" />
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Open in File Explorer"
                Click="OnShowInExplorerClick">
        <MenuItem.Icon>
          <Viewbox Width="17" Height="17">
            <Canvas Width="18" Height="18">
              <Path Data="M1.5,4.5 H7 L8.7,6.3 H16.5 V15.5 H1.5 Z"
                    Fill="#E8B84A"
                    Stroke="#FFE09A"
                    StrokeThickness="1"
                    StrokeLineJoin="Round" />
              <Path Data="M1.5,7 H16.5"
                    Stroke="#9B7628"
                    StrokeThickness="1" />
            </Canvas>
          </Viewbox>
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy filename"
                Click="OnCopyFileNameClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#D9E6F2"
                     Text="▤" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy full path"
                Click="OnCopyFullPathClick">
        <MenuItem.Icon>
          <Viewbox Width="17" Height="17">
            <Canvas Width="18" Height="18">
              <Path Data="M5.5,5.5 H15.5 V15.5 H5.5 Z"
                    Fill="#273E52"
                    Stroke="#8BC8FF"
                    StrokeThickness="1.4"
                    StrokeLineJoin="Round" />
              <Path Data="M2.5,12 V2.5 H12"
                    Stroke="#D9E6F2"
                    StrokeThickness="1.4"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </MenuItem.Icon>
      </MenuItem>
      <Separator Style="{StaticResource PhotoContextMenuSeparatorStyle}" />
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Rename…"
                InputGestureText="F2"
                Tag="RenameFile"
                Click="OnRenamePhotoClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#D9E6F2"
                     Text="✎" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Duplicate"
                Tag="DuplicateFiles"
                Click="OnDuplicatePhotoClick">
        <MenuItem.Icon>
          <Viewbox Width="17" Height="17">
            <Canvas Width="18" Height="18">
              <Path Data="M3.5,2.5 H11.5 V10.5 H3.5 Z"
                    Fill="#1D2A38"
                    Stroke="#8BC8FF"
                    StrokeThickness="1.3"
                    StrokeLineJoin="Round" />
              <Path Data="M6.5,5.5 H14.5 V13.5 H6.5 Z"
                    Fill="#273E52"
                    Stroke="#A8D88F"
                    StrokeThickness="1.3"
                    StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </MenuItem.Icon>
      </MenuItem>
      <Separator Style="{StaticResource PhotoContextMenuSeparatorStyle}" />
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy files"
                InputGestureText="Ctrl+C"
                Tag="CopyFiles"
                Click="OnCopyFilesClick">
        <MenuItem.Icon>
          <Viewbox Width="17" Height="17">
            <Canvas Width="18" Height="18">
              <Path Data="M2.5,3.5 H15.5 V14.5 H2.5 Z"
                    Fill="#273E52"
                    Stroke="#8BC8FF"
                    StrokeThickness="1.3"
                    StrokeLineJoin="Round" />
              <Ellipse Canvas.Left="10.5"
                       Canvas.Top="5"
                       Width="2.4"
                       Height="2.4"
                       Fill="#FFD36A" />
              <Path Data="M4,12 L7.2,8.7 L9.6,11.1 L11.1,9.7 L14.2,12.8"
                    Stroke="#A8D88F"
                    StrokeThickness="1.3"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Paste files"
                InputGestureText="Ctrl+V"
                Tag="PasteFiles"
                Click="OnPasteFilesClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#A8D88F"
                     Text="▣" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy rendered image pixels"
                Click="OnCopyImageClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#8BC8FF"
                     Text="▧" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator Style="{StaticResource PhotoContextMenuSeparatorStyle}" />
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Batch convert…"
                InputGestureText="Ctrl+B"
                Tag="BatchConvert"
                Click="OnBatchConvertClick">
        <MenuItem.Icon>
          <Viewbox Width="17" Height="17">
            <Canvas Width="18" Height="18">
              <Path Data="M2.5,4.5 H10.5 V12.5 H2.5 Z"
                    Fill="#273E52"
                    Stroke="#8BC8FF"
                    StrokeThickness="1.3"
                    StrokeLineJoin="Round" />
              <Path Data="M7.5,9.5 H15.5 V17.5 H7.5 Z"
                    Fill="#1D2A38"
                    Stroke="#A8D88F"
                    StrokeThickness="1.3"
                    StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Describe with AI…"
                Tag="AiDescribe"
                Click="OnAiDescribeClick">
        <MenuItem.Icon>
          <Viewbox Width="17" Height="17">
            <Canvas Width="18" Height="18">
              <Path Data="M8.5,1.5 L10.2,6.8 L15.5,8.5 L10.2,10.2 L8.5,15.5 L6.8,10.2 L1.5,8.5 L6.8,6.8 Z"
                    Fill="#8BC8FF"
                    Stroke="#C9E6FF"
                    StrokeThickness="0.8"
                    StrokeLineJoin="Round" />
              <Path Data="M14.5,12.5 L15.2,14.3 L17,15 L15.2,15.7 L14.5,17.5 L13.8,15.7 L12,15 L13.8,14.3 Z"
                    Fill="#FFD36A" />
            </Canvas>
          </Viewbox>
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Find people…"
                Tag="FindPeople"
                Click="OnPeopleContextClick">
        <MenuItem.Icon>
          <Viewbox Width="17" Height="17">
            <Canvas Width="18" Height="18">
              <Ellipse Canvas.Left="5.4"
                       Canvas.Top="2"
                       Width="7.2"
                       Height="7.2"
                       Stroke="#8BC8FF"
                       StrokeThickness="1.4" />
              <Path Data="M2.8,16 C3.3,12.4 5.7,10.8 9,10.8 C12.3,10.8 14.7,12.4 15.2,16"
                    Stroke="#8BC8FF"
                    StrokeThickness="1.4"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
        </MenuItem.Icon>
      </MenuItem>
      <Separator Style="{StaticResource PhotoContextMenuSeparatorStyle}" />
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy to…"
                InputGestureText="Alt+C"
                Tag="CopyTo"
                Click="OnCopyFilesToClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#E8B84A"
                     Text="↗" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Move to…"
                InputGestureText="Alt+X"
                Tag="MoveTo"
                Click="OnMoveFilesToClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#FFD36A"
                     Text="⇢" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy to last destination"
                InputGestureText="Ctrl+Shift+C"
                Tag="LastCopyDestination"
                Visibility="Collapsed"
                Click="OnCopyFileToLastDestinationClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#8BC8FF"
                     Text="⇉" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator Style="{StaticResource PhotoContextMenuSeparatorStyle}" />
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Move to Recycle Bin"
                InputGestureText="Del"
                Tag="DeleteFiles"
                Click="OnDeleteFilesClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="17"
                     Foreground="#FF9A9A"
                     Text="⌫" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>

    <ContextMenu x:Key="EditorContextMenu"
                 Style="{StaticResource PhotoContextMenuStyle}"
                 Opened="OnEditorContextMenuOpened">
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Select region"
                Tag="Select"
                Click="OnStartSelectionClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#8BC8FF"
                     Text="▧" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Crop selection"
                Tag="Crop"
                Click="OnCropSelectionClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#8BC8FF"
                     Text="⌗" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy to clipboard"
                Tag="Copy"
                Click="OnCopySelectionClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#8BC8FF"
                     Text="⧉" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator Tag="SelectionActionsSeparator" />
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Clear selection"
                Tag="Clear"
                Click="OnClearSelectionClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="17"
                     Foreground="#C8CDD8"
                     Text="×" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
    <!-- Gallery presentation. Grid and Details share the container chrome and
         the context menu; only the layout and the row content differ. -->
    <Style x:Key="PhotoTileContainerStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="5" />
      <Setter Property="Tag" Value="{Binding}" />
      <Setter Property="ContextMenu"
              Value="{StaticResource PhotoFileContextMenu}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="#333844" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </Trigger>
        <DataTrigger Binding="{Binding IsRejected}" Value="True">
          <Setter Property="Opacity" Value="0.42" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PhotoDetailsContainerStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource PhotoTileContainerStyle}">
      <Setter Property="Margin" Value="0,0,0,1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#242832" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#284967" />
          <Setter Property="BorderThickness" Value="0" />
        </Trigger>
        <DataTrigger Binding="{Binding IsRejected}" Value="True">
          <Setter Property="Opacity" Value="0.42" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="PhotoTileTemplate">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="{Binding DataContext.ThumbnailImageHeight,
                                          RelativeSource={RelativeSource AncestorType=ListBox}}" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#0C0E12" ClipToBounds="True">
          <controls:ThumbnailPresenter SourcePath="{Binding Path}"
                                       Stretch="UniformToFill"
                                       TileWidth="{Binding DataContext.ThumbnailSize,
                                                           RelativeSource={RelativeSource AncestorType=ListBox}}" />
        </Border>
        <Border Margin="5"
                Padding="5,1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{Binding ColorLabelBrush}"
                CornerRadius="3"
                Visibility="{Binding HasColorLabel,
                                     Converter={StaticResource BoolToVisibility}}">
          <TextBlock FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="#0C0E12"
                     Text="{Binding ColorLabel}" />
        </Border>
        <TextBlock Margin="6,4"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   FontFamily="Segoe UI Symbol"
                   FontSize="15"
                   Foreground="#F2F4F8"
                   Text="{Binding FlagGlyph}"
                   Visibility="{Binding FlagGlyph,
                                        Converter={StaticResource NullToCollapsed}}">
          <TextBlock.Effect>
            <DropShadowEffect BlurRadius="4"
                              Opacity="0.9"
                              ShadowDepth="0"
                              Color="Black" />
          </TextBlock.Effect>
        </TextBlock>
        <!-- The quiet warnings: a probably-approximate GPS fix; someone
             blinked or is not smiling. A photo that passes shows nothing. -->
        <StackPanel Margin="5,0,5,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Orientation="Horizontal">
          <Border Padding="4,1,4,2"
                  Background="#CC14161C"
                  CornerRadius="8"
                  Visibility="{Binding IsLocationApproximate,
                                       Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontFamily="Segoe UI Emoji"
                       FontSize="11"
                       Text="📍≈" />
          </Border>
          <Border Margin="3,0,0,0"
                  Padding="4,1,4,2"
                  Background="#CC14161C"
                  CornerRadius="8"
                  Visibility="{Binding ExpressionGlyph,
                                       Converter={StaticResource NullToCollapsed}}">
            <TextBlock FontFamily="Segoe UI Emoji"
                       FontSize="11"
                       Text="{Binding ExpressionGlyph}" />
          </Border>
        </StackPanel>
        <!-- Who is on the photo, quietly in the corner of the thumbnail. -->
        <ItemsControl Margin="5,0,5,4"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False"
                      ItemsSource="{Binding People}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,2,3,0"
                      Padding="5,1,6,2"
                      Background="#CC14161C"
                      CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7"
                           Height="7"
                           Margin="0,1,4,0"
                           VerticalAlignment="Center"
                           Fill="{Binding Converter={StaticResource PersonBrush}}" />
                  <TextBlock FontSize="10"
                             Foreground="#E8ECF2"
                             Text="{Binding Name}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="1" Margin="8,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="#F2F4F8"
                     Text="{Binding FileName}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Path}" />
          <TextBlock Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="#FFD36A"
                     Text="{Binding RatingText}" />
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PhotoDetailsTemplate">
      <Grid Margin="6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" MinWidth="120" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="7"
                Height="7"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{Binding ColorLabelBrush}"
                CornerRadius="4"
                Visibility="{Binding HasColorLabel,
                                     Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="#F2F4F8"
                   Text="{Binding FileName}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Path}" />
        <TextBlock Grid.Column="2"
                   Width="132"
                   Margin="10,0,0,0"
                   Style="{StaticResource InfoValueStyle}"
                   Foreground="#AAB2C0"
                   Text="{Binding TakenAtText}" />
        <TextBlock Grid.Column="3"
                   Width="86"
                   Margin="10,0,0,0"
                   Style="{StaticResource InfoValueStyle}"
                   Foreground="#AAB2C0"
                   Text="{Binding DimensionsText}" />
        <TextBlock Grid.Column="4"
                   Width="64"
                   Margin="10,0,0,0"
                   Style="{StaticResource InfoValueStyle}"
                   Foreground="#AAB2C0"
                   Text="{Binding FileSizeText}" />
        <TextBlock Grid.Column="5"
                   Width="52"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="#FFD36A"
                   Text="{Binding RatingText}" />
      </Grid>
    </DataTemplate>

  </Window.Resources>

  <Grid>
    <Grid.Resources>
      <!-- The navigation and status strips belong to Manager; Editor and
           fullscreen give the whole window to the photograph. -->
      <Style x:Key="ManagerChromeRowStyle" TargetType="RowDefinition">
        <Setter Property="Height" Value="Auto" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsEditorMode}" Value="True">
            <Setter Property="Height" Value="0" />
          </DataTrigger>
          <DataTrigger Binding="{Binding IsFullscreenMode}" Value="True">
            <Setter Property="Height" Value="0" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Style="{StaticResource ManagerChromeRowStyle}" />
      <RowDefinition Height="*" />
      <RowDefinition Style="{StaticResource ManagerChromeRowStyle}" />
    </Grid.RowDefinitions>

    <!-- Tab strip: appears once an editor is open and survives the switch
         back to Manager; only fullscreen hides it. -->
    <Border x:Name="EditorTabStrip"
            Grid.Row="0"
            Background="#14161C"
            BorderBrush="#303541"
            BorderThickness="0,0,0,1"
            Padding="6,5,6,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasEditorTabs}" Value="False">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFullscreenMode}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
          <Border>
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource EditorTabStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsEditorMode}" Value="False">
                    <Setter Property="Background" Value="#284967" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Button AutomationProperties.Name="Manager tab"
                    Style="{StaticResource TabLabelButtonStyle}"
                    ToolTip="Back to the gallery; open editors stay on their tabs"
                    Click="OnManagerTabClick">
              <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,6,0"
                           FontFamily="Segoe UI Symbol"
                           Foreground="#8BC8FF"
                           Text="▤" />
                <TextBlock Text="Manager" />
              </StackPanel>
            </Button>
          </Border>
          <ItemsControl x:Name="EditorTabList"
                        ItemsSource="{Binding EditorTabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border>
                  <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource EditorTabStyle}">
                      <Style.Triggers>
                        <DataTrigger Value="True">
                          <DataTrigger.Binding>
                            <MultiBinding
                                Converter="{StaticResource ActiveEditorTab}">
                              <Binding />
                              <Binding Path="DataContext.SelectedPhoto"
                                       RelativeSource="{RelativeSource
                                           AncestorType=Window}" />
                              <Binding Path="DataContext.IsEditorMode"
                                       RelativeSource="{RelativeSource
                                           AncestorType=Window}" />
                            </MultiBinding>
                          </DataTrigger.Binding>
                          <Setter Property="Background" Value="#284967" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TabLabelButtonStyle}"
                            Tag="{Binding}"
                            ToolTip="{Binding Path}"
                            Click="OnEditorTabClick">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   FontSize="9"
                                   Foreground="#FFD36A"
                                   Text="●"
                                   ToolTip="Unsaved edits"
                                   Visibility="{Binding IsEditorDirty,
                                                        Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Foreground="#F2F4F8"
                                   Text="{Binding FileName}" />
                      </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Close editor tab"
                            Style="{StaticResource TabCloseButtonStyle}"
                            Content="✕"
                            Tag="{Binding}"
                            ToolTip="Close this editor"
                            Click="OnEditorTabCloseClick" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Navigation -->
    <Border x:Name="NavigationBar"
            Grid.Row="1"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#303541"
            BorderThickness="0,0,0,1"
            Padding="6,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
          <Button AutomationProperties.Name="Back"
                  Command="{Binding GoBackCommand}"
                  Content="◀"
                  Style="{StaticResource NavigationButtonStyle}"
                  ToolTip="Back (Alt+Left)" />
          <Button AutomationProperties.Name="Forward"
                  Command="{Binding GoForwardCommand}"
                  Content="▶"
                  Style="{StaticResource NavigationButtonStyle}"
                  ToolTip="Forward (Alt+Right)" />
          <Button AutomationProperties.Name="Up one folder"
                  Command="{Binding GoUpCommand}"
                  Content="▲"
                  Style="{StaticResource NavigationButtonStyle}"
                  ToolTip="Up one folder (Alt+Up)" />
          <Button AutomationProperties.Name="Refresh"
                  Command="{Binding RefreshCommand}"
                  Content="⟳"
                  Style="{StaticResource NavigationButtonStyle}"
                  ToolTip="Refresh (F5)" />
        </StackPanel>

        <Border Grid.Column="1"
                Margin="8,0"
                Padding="4,0"
                Background="#111318"
                BorderBrush="#3A3F4B"
                BorderThickness="1"
                CornerRadius="4">
          <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="BreadcrumbBar" ItemsSource="{Binding Breadcrumb}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding OpenCommand}"
                            Content="{Binding Name}"
                            Style="{StaticResource BreadcrumbButtonStyle}"
                            ToolTip="{Binding FullPath}">
                      <Button.Resources>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource BreadcrumbButtonStyle}" />
                      </Button.Resources>
                    </Button>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#5D6675"
                               Text="›"
                               Visibility="{Binding IsLast,
                                                    Converter={StaticResource BoolToVisibility},
                                                    ConverterParameter=invert}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Margin="1,0"
                  Padding="10,4"
                  AutomationProperties.Name="Import photos"
                  Content="Import…"
                  Click="OnImportClick"
                  ToolTip="Import from a camera or memory card (Ctrl+I)" />
          <Button Margin="1,0"
                  Padding="10,4"
                  AutomationProperties.Name="Compare selected photos"
                  Content="Compare"
                  Click="OnCompareClick"
                  ToolTip="Compare 2–4 selected photos side by side (Ctrl+K)" />
          <Button Margin="1,0"
                  Padding="10,4"
                  AutomationProperties.Name="People"
                  Content="People"
                  Click="OnPeopleClick"
                  ToolTip="Find faces in the selected photos and name the people on them; with nothing selected the whole folder is scanned" />
          <Button Margin="1,0"
                  Padding="10,4"
                  AutomationProperties.Name="Create folder"
                  Content="New folder"
                  Click="OnCreateFolderClick"
                  ToolTip="Create a folder inside the current one" />
          <Button Margin="1,0"
                  Padding="10,4"
                  AutomationProperties.Name="Batch convert"
                  Content="Batch…"
                  Click="OnBatchToolbarClick"
                  ToolTip="Batch convert the selected photos (Ctrl+B)" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavigatorColumn"
                          Width="260"
                          MinWidth="180" />
        <ColumnDefinition x:Name="NavigatorSplitterColumn" Width="5" />
        <ColumnDefinition x:Name="CatalogColumn"
                          Width="420"
                          MinWidth="280" />
        <ColumnDefinition x:Name="CatalogSplitterColumn" Width="5" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition x:Name="EditorSplitterColumn" Width="0" />
        <ColumnDefinition x:Name="EditorPanelColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="#303541"
                BorderThickness="0,0,0,1"
                Padding="5,4">
          <StackPanel Orientation="Horizontal">
            <Button Width="30"
                    Height="30"
                    Margin="0,0,4,0"
                    Padding="0"
                    AutomationProperties.Name="Open folder"
                    Command="{Binding OpenFolderCommand}"
                    ToolTip="Open folder">
              <TextBlock VerticalAlignment="Center"
                         FontFamily="Segoe UI Emoji"
                         FontSize="15"
                         Text="📁" />
            </Button>
            <CheckBox Content="Recursive"
                      IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                      ToolTip="Scan the selected folder recursively" />
          </StackPanel>
        </Border>

        <TreeView x:Name="DirectoryTreeView"
                  Grid.Row="1"
                  Padding="4,8"
                  Background="{StaticResource PanelBrush}"
                  BorderThickness="0"
                  Foreground="#E4E7ED"
                  ItemsSource="{Binding DirectoryTree.Roots}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
        <TreeView.Resources>
          <Style TargetType="ScrollBar"
                 BasedOn="{StaticResource PaneScrollBarStyle}" />
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#284967" />
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#284967" />
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
          <HierarchicalDataTemplate DataType="{x:Type viewModels:DirectoryNodeViewModel}"
                                    ItemsSource="{Binding Children}">
            <Grid Margin="2,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         VerticalAlignment="Center"
                         FontFamily="Segoe UI Symbol, Segoe UI Emoji"
                         Foreground="#A9CFF2"
                         Text="{Binding Glyph}" />
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         Text="{Binding DisplayName}"
                         ToolTip="{Binding FullPath}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Column="2"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="#79808D"
                         Text="…">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLoading}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </HierarchicalDataTemplate>
        </TreeView.Resources>
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#E4E7ED" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected"
                    Value="{Binding IsSelected, Mode=TwoWay}" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#284967" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="IsHitTestVisible" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TreeView.ItemContainerStyle>
        </TreeView>
      </Grid>

      <GridSplitter Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Background="#303541"
                    DragCompleted="OnPaneSplitterDragCompleted" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="#303541"
                BorderThickness="0,0,0,1"
                Padding="5,4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center"
                        Orientation="Horizontal">
              <TextBlock Margin="0,0,5,0"
                         VerticalAlignment="Center"
                         Foreground="#9299A7"
                         Text="Search" />
              <TextBox x:Name="PhotoSearchBox"
                       Width="180"
                       Height="25"
                       Margin="0,0,8,0"
                       Padding="6,3"
                       VerticalContentAlignment="Center"
                       Background="#111318"
                       BorderBrush="#4A5160"
                       Foreground="#F2F4F8"
                       SelectionBrush="{StaticResource AccentBrush}"
                       ToolTip="Search the gallery by name, keyword or person"
                       Text="{Binding SearchText,
                                      UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <ComboBox x:Name="SortFieldBox"
                      Grid.Column="1"
                      MinWidth="128"
                      AutomationProperties.Name="Sort by"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SortField, Mode=TwoWay}"
                      ToolTip="Sort the gallery by">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource SortFieldName}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <ToggleButton x:Name="FilterButton"
                          Grid.Column="2"
                          Margin="6,0,0,0"
                          Content="{Binding FilterLabel}"
                          Style="{StaticResource GalleryToolButtonStyle}"
                          ToolTip="Filter the gallery" />

            <StackPanel Grid.Column="4"
                        Orientation="Horizontal">
              <Slider x:Name="ThumbnailSizeSlider"
                      Width="86"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Thumbnail size"
                      Maximum="460"
                      Minimum="108"
                      Value="{Binding ThumbnailSize, Mode=TwoWay}"
                      ToolTip="Thumbnail size (Ctrl+wheel over the gallery)"
                      Visibility="{Binding IsGridView,
                                           Converter={StaticResource BoolToVisibility}}" />
              <Button Width="32"
                      Height="26"
                      Margin="0,0,6,0"
                      Padding="0"
                      AutomationProperties.Name="Sort direction"
                      Command="{Binding ToggleSortDirectionCommand}"
                      Content="{Binding SortDirectionGlyph}"
                      ToolTip="{Binding SortDirectionToolTip}" />
              <ToggleButton AutomationProperties.Name="Grid view"
                            Content="▦"
                            IsChecked="{Binding ViewMode,
                                                Converter={StaticResource EnumEquals},
                                                ConverterParameter=Grid,
                                                Mode=TwoWay}"
                            Style="{StaticResource GalleryToolButtonStyle}"
                            ToolTip="Thumbnail grid" />
              <ToggleButton AutomationProperties.Name="Details view"
                            Content="☰"
                            IsChecked="{Binding ViewMode,
                                                Converter={StaticResource EnumEquals},
                                                ConverterParameter=Details,
                                                Mode=TwoWay}"
                            Style="{StaticResource GalleryToolButtonStyle}"
                            ToolTip="Details list" />
            </StackPanel>
          </Grid>
        </Border>

        <Popup x:Name="FilterPopup"
               AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=FilterButton}"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=FilterButton}"
               StaysOpen="False"
               Closed="OnFilterPopupClosed">
          <Border Width="340"
                  Background="{StaticResource PanelBrush}"
                  BorderBrush="#4A5160"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="14">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="RATING" />
              <controls:RatingPicker Margin="0,0,0,10"
                                     AutomationProperties.Name="Minimum rating"
                                     RatingToolTipFormat="At least {0} stars"
                                     UnratedToolTip="No rating filter"
                                     Value="{Binding MinimumRating, Mode=TwoWay}" />

              <TextBlock Style="{StaticResource SectionHeaderStyle}"
                         Text="COLOUR LABEL" />
              <StackPanel x:Name="LabelFilterPanel"
                          Margin="0,0,0,10"
                          Orientation="Horizontal" />

              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="FLAG" />
              <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <CheckBox x:Name="PickedFilterBox"
                          Content="Picked"
                          Click="OnFilterChanged" />
                <CheckBox x:Name="RejectedFilterBox"
                          Margin="12,0,0,0"
                          Content="Rejected"
                          Click="OnFilterChanged" />
                <CheckBox x:Name="HideRejectedBox"
                          Margin="12,0,0,0"
                          Content="Hide rejects"
                          Click="OnFilterChanged" />
              </StackPanel>

              <TextBlock Style="{StaticResource SectionHeaderStyle}"
                         Text="ORIENTATION" />
              <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <RadioButton x:Name="AnyOrientationBox"
                             Content="Any"
                             GroupName="Orientation"
                             IsChecked="True"
                             Click="OnFilterChanged" />
                <RadioButton x:Name="LandscapeOrientationBox"
                             Margin="10,0,0,0"
                             Content="Landscape"
                             GroupName="Orientation"
                             Click="OnFilterChanged" />
                <RadioButton x:Name="PortraitOrientationBox"
                             Margin="10,0,0,0"
                             Content="Portrait"
                             GroupName="Orientation"
                             Click="OnFilterChanged" />
              </StackPanel>

              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="FORMAT" />
              <ItemsControl x:Name="FormatFilterItems"
                            Margin="0,0,0,10"
                            ItemsSource="{Binding AvailableFormats}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Margin="0,0,10,0"
                              Content="{Binding}"
                              Tag="{Binding}"
                              Click="OnFilterChanged" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Style="{StaticResource SectionHeaderStyle}"
                         Text="PEOPLE" />
              <!-- One toggle chip per named person; checking several means
                   "all of them together on the photo". -->
              <WrapPanel x:Name="PersonFilterPanel"
                         Margin="0,0,0,8"
                         Orientation="Horizontal" />

              <TextBlock Style="{StaticResource SectionHeaderStyle}"
                         Text="EXPRESSION" />
              <!-- From the face scan's smile and eyes scores. "Smiling" and
                   "Open" mean everyone on the photo; the opposite side keeps
                   the rejects of a portrait cull. -->
              <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                <TextBlock Width="42"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#79808D"
                           Text="Smile" />
                <RadioButton x:Name="AnySmileBox"
                             Content="Any"
                             GroupName="SmileFilter"
                             IsChecked="True"
                             Click="OnFilterChanged" />
                <RadioButton x:Name="SmilingBox"
                             Margin="10,0,0,0"
                             Content="Smiling"
                             GroupName="SmileFilter"
                             ToolTip="Everyone on the photo is smiling"
                             Click="OnFilterChanged" />
                <RadioButton x:Name="NotSmilingBox"
                             Margin="10,0,0,0"
                             Content="Not smiling"
                             GroupName="SmileFilter"
                             ToolTip="At least one face is not smiling"
                             Click="OnFilterChanged" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <TextBlock Width="42"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#79808D"
                           Text="Eyes" />
                <RadioButton x:Name="AnyEyesBox"
                             Content="Any"
                             GroupName="EyesFilter"
                             IsChecked="True"
                             Click="OnFilterChanged" />
                <RadioButton x:Name="EyesOpenBox"
                             Margin="10,0,0,0"
                             Content="Open"
                             GroupName="EyesFilter"
                             ToolTip="Everyone has both eyes open"
                             Click="OnFilterChanged" />
                <RadioButton x:Name="EyesClosedBox"
                             Margin="10,0,0,0"
                             Content="Blinked"
                             GroupName="EyesFilter"
                             ToolTip="At least one face has closed eyes"
                             Click="OnFilterChanged" />
              </StackPanel>

              <TextBlock Style="{StaticResource SectionHeaderStyle}"
                         Text="LOCATION" />
              <!-- From the GPS evidence read out of the file: the receiver's
                   own error estimate, or a fix already minutes stale when the
                   shutter fired. -->
              <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <RadioButton x:Name="AnyLocationBox"
                             Content="Any"
                             GroupName="LocationFilter"
                             IsChecked="True"
                             Click="OnFilterChanged" />
                <RadioButton x:Name="PreciseLocationBox"
                             Margin="10,0,0,0"
                             Content="Precise"
                             GroupName="LocationFilter"
                             ToolTip="Has coordinates and nothing suggests they are off"
                             Click="OnFilterChanged" />
                <RadioButton x:Name="ApproximateLocationBox"
                             Margin="10,0,0,0"
                             Content="Approximate"
                             GroupName="LocationFilter"
                             ToolTip="The GPS fix was coarse or stale when the photo was taken"
                             Click="OnFilterChanged" />
              </StackPanel>

              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="CAMERA" />
              <ComboBox x:Name="CameraFilterBox"
                        Margin="0,0,0,8"
                        ItemsSource="{Binding AvailableCameras}"
                        SelectionChanged="OnFilterChanged" />
              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="LENS" />
              <ComboBox x:Name="LensFilterBox"
                        Margin="0,0,0,10"
                        ItemsSource="{Binding AvailableLenses}"
                        SelectionChanged="OnFilterChanged" />

              <TextBlock Style="{StaticResource SectionHeaderStyle}"
                         Text="DATE TAKEN" />
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Landing the caret in a box opens its calendar right
                     underneath; typing a year or year-month keeps working
                     and just pages the calendar along. -->
                <TextBox x:Name="DateFromBox"
                         GotKeyboardFocus="OnDateBoxGotFocus"
                         LostKeyboardFocus="OnDateBoxLostFocus"
                         PreviewKeyDown="OnDateBoxPreviewKeyDown"
                         PreviewMouseLeftButtonUp="OnDateBoxMouseUp"
                         TextChanged="OnDateBoxTextChanged"
                         ToolTip="From, e.g. 2025, 2025-07 or 2025-07-04" />
                <TextBlock Grid.Column="1"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           Foreground="#79808D"
                           Text="—" />
                <TextBox x:Name="DateToBox"
                         Grid.Column="2"
                         GotKeyboardFocus="OnDateBoxGotFocus"
                         LostKeyboardFocus="OnDateBoxLostFocus"
                         PreviewKeyDown="OnDateBoxPreviewKeyDown"
                         PreviewMouseLeftButtonUp="OnDateBoxMouseUp"
                         TextChanged="OnDateBoxTextChanged"
                         ToolTip="To, e.g. 2025, 2025-07 or 2025-07-04" />
                <Popup x:Name="DateFromCalendarPopup"
                       AllowsTransparency="True"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=DateFromBox}"
                       StaysOpen="True">
                  <Calendar x:Name="DateFromCalendar"
                            SelectedDatesChanged="OnDateCalendarSelectionChanged" />
                </Popup>
                <Popup x:Name="DateToCalendarPopup"
                       AllowsTransparency="True"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=DateToBox}"
                       StaysOpen="True">
                  <Calendar x:Name="DateToCalendar"
                            SelectedDatesChanged="OnDateCalendarSelectionChanged" />
                </Popup>
              </Grid>
              <TextBlock Margin="0,0,0,12"
                         FontSize="11"
                         Foreground="#79808D"
                         Text="Year, year-month or full date."
                         TextWrapping="Wrap" />

              <Button HorizontalAlignment="Right"
                      Command="{Binding ClearFilterCommand}"
                      Content="Clear filter"
                      Click="OnClearFilterClick" />
            </StackPanel>
          </Border>
        </Popup>

        <ListBox x:Name="PhotoList"
                 Grid.Row="1"
                 Background="{StaticResource PanelBrush}"
                 BorderThickness="0"
                 ItemsSource="{Binding Photos}"
                 SelectionMode="Extended"
                 SelectedItem="{Binding SelectedPhoto}"
                 SelectionChanged="OnPhotoListSelectionChanged"
                 MouseDoubleClick="OnPhotoListMouseDoubleClick"
                 PreviewMouseDown="OnPhotoListPreviewMouseDown"
                 PreviewMouseWheel="OnPhotoListPreviewMouseWheel"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.Resources>
          <Style TargetType="ScrollBar"
                 BasedOn="{StaticResource PhotoListScrollBarStyle}" />
        </ListBox.Resources>
        <ListBox.Style>
          <Style TargetType="ListBox">
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <controls:VirtualizingTilePanel
                    ItemWidth="{Binding ThumbnailSize}"
                    ItemHeight="{Binding ThumbnailTileHeight}" />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate"
                    Value="{StaticResource PhotoTileTemplate}" />
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource PhotoTileContainerStyle}" />
            <Style.Triggers>
              <!-- Details rows fill the pane width, so the tile panel is
                   swapped for a plain stack of full-width rows. -->
              <DataTrigger Binding="{Binding IsDetailsView}" Value="True">
                <Setter Property="ItemsPanel">
                  <Setter.Value>
                    <ItemsPanelTemplate>
                      <controls:VirtualizingTilePanel ItemWidth="100000"
                                                      ItemHeight="30" />
                    </ItemsPanelTemplate>
                  </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate"
                        Value="{StaticResource PhotoDetailsTemplate}" />
                <Setter Property="ItemContainerStyle"
                        Value="{StaticResource PhotoDetailsContainerStyle}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListBox.Style>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    Background="#303541"
                    DragCompleted="OnPaneSplitterDragCompleted" />

      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition>
            <RowDefinition.Style>
              <Style TargetType="RowDefinition">
                <Setter Property="Height" Value="0" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsEditorMode}" Value="True" />
                      <Condition Binding="{Binding IsFullscreenMode}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Height" Value="Auto" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </RowDefinition.Style>
          </RowDefinition>
          <RowDefinition x:Name="ManagerPreviewRow" Height="*" />
          <!-- The split bar and the info pane; the SplitPaneController owns
               these heights, and zeroes them for the editor and fullscreen. -->
          <RowDefinition x:Name="ManagerInfoSplitterRow" Height="13" />
          <RowDefinition x:Name="ManagerInfoRow" Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#303541"
                BorderThickness="0,0,0,1"
                Padding="6">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <ToggleButton x:Name="SelectRegionButton"
                          AutomationProperties.Name="Select image region"
                          Content="Select"
                          IsChecked="{Binding IsSelectionMode,
                                              ElementName=PreviewViewer,
                                              Mode=OneWay}"
                          Style="{StaticResource EditorSelectToggleButtonStyle}"
                          ToolTip="Select an image region (C)"
                          Click="OnSelectRegionClick" />
            <StackPanel x:Name="SelectionActionsPanel"
                        Margin="3,0,0,0"
                        Orientation="Horizontal">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasSelection,
                                                  ElementName=PreviewViewer}"
                                 Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Button x:Name="CropSelectionButton"
                      AutomationProperties.Name="Crop to selection"
                      Content="Crop"
                      Style="{StaticResource EditorActionButtonStyle}"
                      ToolTip="Crop to selection (Enter)"
                      Click="OnCropSelectionClick" />
              <Button x:Name="CopySelectionButton"
                      AutomationProperties.Name="Copy selection"
                      Content="Copy"
                      Style="{StaticResource EditorActionButtonStyle}"
                      ToolTip="Copy selection to clipboard (Ctrl+C)"
                      Click="OnCopySelectionClick" />
            </StackPanel>
            <Separator Margin="8,2" />
            <Button Content="Undo"
                    Style="{StaticResource EditorActionButtonStyle}"
                    ToolTip="Undo edit (Ctrl+Z)"
                    Command="{Binding SelectedPhoto.UndoEditCommand}" />
            <Button Content="Redo"
                    Style="{StaticResource EditorActionButtonStyle}"
                    ToolTip="Redo edit (Ctrl+Y)"
                    Command="{Binding SelectedPhoto.RedoEditCommand}" />
            <Separator Margin="8,2" />
            <Button AutomationProperties.Name="Rotate left"
                    Content="↶"
                    Style="{StaticResource EditorToolButtonStyle}"
                    ToolTip="Rotate left"
                    Command="{Binding SelectedPhoto.RotateLeftCommand}" />
            <Button AutomationProperties.Name="Rotate right"
                    Content="↷"
                    Style="{StaticResource EditorToolButtonStyle}"
                    ToolTip="Rotate right"
                    Command="{Binding SelectedPhoto.RotateRightCommand}" />
            <Button AutomationProperties.Name="Flip horizontally"
                    Content="⇋"
                    Style="{StaticResource EditorToolButtonStyle}"
                    ToolTip="Flip horizontally"
                    Command="{Binding SelectedPhoto.FlipHorizontalCommand}" />
            <Button AutomationProperties.Name="Flip vertically"
                    Content="⇅"
                    Style="{StaticResource EditorToolButtonStyle}"
                    ToolTip="Flip vertically"
                    Click="OnFlipVerticalClick" />
            <Button AutomationProperties.Name="Reset all edits"
                    Content="Reset edits"
                    Style="{StaticResource EditorResetButtonStyle}"
                    ToolTip="Reset every edit on this photo"
                    Command="{Binding SelectedPhoto.ResetEditsCommand}" />
            <Separator Margin="8,2" />
            <ToggleButton x:Name="BeforeAfterButton"
                          AutomationProperties.Name="Compare with the original"
                          Content="Before"
                          Style="{StaticResource EditorSelectToggleButtonStyle}"
                          ToolTip="Show the original (B)"
                          Click="OnBeforeAfterChanged" />
            <ToggleButton x:Name="SplitCompareButton"
                          AutomationProperties.Name="Split comparison"
                          Content="Split"
                          Style="{StaticResource EditorSelectToggleButtonStyle}"
                          ToolTip="Split the canvas: original left, edited right"
                          Click="OnBeforeAfterChanged" />
            <Separator Margin="8,2" />
            <Button AutomationProperties.Name="Apply a filter"
                    Content="Filters…"
                    Style="{StaticResource EditorActionButtonStyle}"
                    ToolTip="Sharpen, blur, pixelize, grayscale and more"
                    Click="OnFiltersClick" />
            <Button AutomationProperties.Name="Save current image as JPEG"
                    Content="Save as…"
                    Style="{StaticResource EditorActionButtonStyle}"
                    ToolTip="Save current image as (Ctrl+Shift+S)"
                    Click="OnSaveAsClick" />
            <Button AutomationProperties.Name="Export the current image"
                    Content="Export…"
                    Style="{StaticResource EditorActionButtonStyle}"
                    ToolTip="Export with resize, format and quality (Ctrl+E)"
                    Click="OnExportClick" />
            <Button AutomationProperties.Name="Upload current image to Imgur"
                    Content="Upload"
                    Style="{StaticResource EditorActionButtonStyle}"
                    ToolTip="Upload current image to Imgur and copy URL (Ctrl+U)"
                    Click="OnUploadToImgurClick" />
            <Separator Margin="8,2" />
            <ToggleButton x:Name="FacesOverlayButton"
                          AutomationProperties.Name="Show face frames"
                          Content="Faces"
                          Style="{StaticResource EditorSelectToggleButtonStyle}"
                          ToolTip="Frame the known faces on the photograph"
                          Checked="OnFacesOverlayToggled"
                          Unchecked="OnFacesOverlayToggled" />
            <ToggleButton x:Name="MetadataPanelButton"
                          AutomationProperties.Name="Edit photo metadata"
                          Content="Info"
                          Style="{StaticResource EditorSelectToggleButtonStyle}"
                          ToolTip="Edit title, description and GPS location" />
            <Popup AllowsTransparency="True"
                   IsOpen="{Binding IsChecked, ElementName=MetadataPanelButton}"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=MetadataPanelButton}"
                   StaysOpen="True">
              <Border Width="340"
                      Background="{StaticResource PanelBrush}"
                      BorderBrush="#4A5160"
                      BorderThickness="1"
                      Padding="12">
                <StackPanel>
                  <TextBlock Foreground="#C8CDD8" Text="Title" />
                  <TextBox Margin="0,3,0,0"
                           Padding="6,3"
                           Background="#111318"
                           BorderBrush="#4A5160"
                           Foreground="#F2F4F8"
                           SelectionBrush="{StaticResource AccentBrush}"
                           Text="{Binding SelectedPhoto.Title,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Margin="0,9,0,0"
                             Foreground="#C8CDD8"
                             Text="Description" />
                  <TextBox Height="64"
                           Margin="0,3,0,0"
                           Padding="6,3"
                           AcceptsReturn="True"
                           Background="#111318"
                           BorderBrush="#4A5160"
                           Foreground="#F2F4F8"
                           SelectionBrush="{StaticResource AccentBrush}"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           Text="{Binding SelectedPhoto.Description,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Margin="0,9,0,0"
                             Foreground="#C8CDD8"
                             Text="GPS (latitude, longitude)" />
                  <TextBox Margin="0,3,0,0"
                           Padding="6,3"
                           Background="#111318"
                           BorderBrush="#4A5160"
                           Foreground="#F2F4F8"
                           SelectionBrush="{StaticResource AccentBrush}"
                           Text="{Binding SelectedPhoto.LocationText,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=LostFocus}"
                           ToolTip="Decimal degrees, e.g. 49.195061, 16.606836" />
                  <TextBlock Margin="0,3,0,0"
                             FontSize="11"
                             Foreground="#FFD36A"
                             Text="{Binding SelectedPhoto.LocationAccuracyText}"
                             TextWrapping="Wrap"
                             Visibility="{Binding SelectedPhoto.LocationAccuracyText,
                                                  Converter={StaticResource NullToCollapsed},
                                                  FallbackValue=Collapsed}" />
                  <TextBlock Margin="0,9,0,0"
                             FontSize="11"
                             Foreground="#79808D"
                             Text="Changes are saved to the catalogue and written into the photo file (XMP/EXIF) in the background. RAW formats use an .xmp sidecar."
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Popup>
          </StackPanel>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- The toolbox: one Photoshop-style column of drawing tools,
               docked at the canvas edge so annotating never means opening
               the Layers tab first. Buttons are built in code-behind. -->
          <Border x:Name="EditorToolbox"
                  Background="{StaticResource PanelBrush}"
                  BorderBrush="#303541"
                  BorderThickness="0,0,1,0"
                  Padding="5,8">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsEditorMode}" Value="True" />
                      <Condition Binding="{Binding IsFullscreenMode}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel x:Name="AnnotationToolPanel" />
          </Border>

          <controls:PhotoViewer x:Name="PreviewViewer"
                              Grid.Column="1"
                              SourcePath="{Binding SelectedPhoto.Path}"
                              SourceBitmap="{Binding SelectedPhoto.SourceBitmap}"
                              Tag="{Binding SelectedPhoto}"
                              ContextMenu="{StaticResource EditorContextMenu}"
                              ContextMenuOpening="OnPreviewContextMenuOpening"
                              EditRecipe="{Binding SelectedPhoto.EditRecipe}"
                              IsEditorMode="{Binding IsEditorMode}"
                              IsFullscreenMode="{Binding IsFullscreenMode}"
                              PreviousPhotoCommand="{Binding GuardedPreviousCommand,
                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                              NextPhotoCommand="{Binding GuardedNextCommand,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                              MiddleClickCommand="{Binding ToggleFullscreenCommand}"
                              DoubleClickCommand="{Binding GuardedToggleEditorCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}" />

          <!-- Parameters of the armed drawing tool, floating beside the
               toolbox the way Photoshop keeps tool options near the canvas.
               Shown from code-behind while a tool is armed or an object is
               selected. -->
          <Border x:Name="ToolOptionsPanel"
                  Grid.Column="1"
                  Width="252"
                  Margin="10,10,0,0"
                  Padding="12,10"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Panel.ZIndex="9"
                  Background="#F0181C24"
                  BorderBrush="#4A5160"
                  BorderThickness="1"
                  CornerRadius="8"
                  Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="ToolOptionsHeader"
                         Style="{StaticResource SectionHeaderStyle}"
                         Text="TOOL" />
              <StackPanel x:Name="AnnotationColorPanel"
                          Margin="0,2,0,6"
                          Orientation="Horizontal" />
              <controls:AdjustmentSlider x:Name="StrokeWidthSlider"
                                         Label="Stroke"
                                         Minimum="1"
                                         Maximum="30"
                                         DefaultValue="4"
                                         ValueFormat="0" />
              <controls:AdjustmentSlider x:Name="LayerOpacitySlider"
                                         Label="Opacity"
                                         Minimum="5"
                                         Maximum="100"
                                         DefaultValue="100"
                                         ValueFormat="0" />
              <CheckBox x:Name="FillShapeBox"
                        Margin="0,4,0,0"
                        Content="Fill"
                        Click="OnLayerAppearanceChanged" />
              <StackPanel x:Name="TextOptionsPanel">
                <controls:AdjustmentSlider x:Name="FontSizeSlider"
                                           Label="Font size"
                                           Minimum="1"
                                           Maximum="25"
                                           DefaultValue="5"
                                           ValueFormat="0" />
                <CheckBox x:Name="TextBackgroundBox"
                          Margin="0,4,0,0"
                          Content="Text plate"
                          Click="OnLayerAppearanceChanged" />
                <TextBox x:Name="LayerTextBox"
                         Margin="0,6,0,0"
                         AutomationProperties.Name="Text of the selected layer"
                         TextChanged="OnLayerTextChanged"
                         ToolTip="Text of the selected text layer" />
              </StackPanel>
            </StackPanel>
          </Border>

        <!-- Fullscreen has no info panel, so the culling verdicts already on
             the photograph - rating, colour label, flag - sit quietly beside
             the close button. A photo without them shows nothing. -->
        <StackPanel x:Name="FullscreenBadges"
                    Grid.Column="1"
                    Margin="0,10,56,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="10"
                    DataContext="{Binding SelectedPhoto}"
                    IsHitTestVisible="False"
                    Orientation="Horizontal">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsFullscreenMode,
                                               RelativeSource={RelativeSource
                                                   AncestorType=Window}}"
                             Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Border Height="34"
                  Margin="0,0,8,0"
                  Padding="12,0"
                  Background="#B0151A22"
                  BorderBrush="#4A5160"
                  BorderThickness="1"
                  CornerRadius="17"
                  Visibility="{Binding RatingText,
                                       Converter={StaticResource NullToCollapsed},
                                       FallbackValue=Collapsed}">
            <TextBlock VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="#FFD36A"
                       Text="{Binding RatingText}" />
          </Border>
          <Border Width="34"
                  Height="34"
                  Margin="0,0,8,0"
                  Background="#B0151A22"
                  BorderBrush="#4A5160"
                  BorderThickness="1"
                  CornerRadius="17"
                  Visibility="{Binding HasColorLabel,
                                       Converter={StaticResource BoolToVisibility},
                                       FallbackValue=Collapsed}">
            <Border Width="12"
                    Height="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{Binding ColorLabelBrush}"
                    CornerRadius="6" />
          </Border>
          <Border Width="34"
                  Height="34"
                  Background="#B0151A22"
                  BorderBrush="#4A5160"
                  BorderThickness="1"
                  CornerRadius="17"
                  Visibility="{Binding FlagGlyph,
                                       Converter={StaticResource NullToCollapsed},
                                       FallbackValue=Collapsed}">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI Symbol"
                       FontSize="14"
                       Foreground="#F2F4F8"
                       Text="{Binding FlagGlyph}" />
          </Border>
        </StackPanel>

        <!-- The mouse-only way out of the editor and the fullscreen preview;
             the keyboard equivalent is Esc. -->
        <Button x:Name="ClosePreviewButton"
                Grid.Column="1"
                Width="34"
                Height="34"
                Margin="0,10,14,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                AutomationProperties.Name="Close the preview"
                Content="✕"
                FontSize="15"
                ToolTip="Close (Esc)"
                Click="OnClosePreviewClick">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Visibility" Value="Collapsed" />
              <Setter Property="Foreground" Value="#D9E6F2" />
              <Setter Property="Background" Value="#B0151A22" />
              <Setter Property="BorderBrush" Value="#4A5160" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="17">
                      <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditorMode}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFullscreenMode}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#E0232B3A" />
                  <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>

        <!-- Transient confirmation for keyboard culling in fullscreen and
             the editor, where the info panel that would normally reflect
             the change is hidden. Shown from code-behind, fades out. -->
        <Border x:Name="ViewerOsd"
                Grid.Column="1"
                Margin="0,0,0,32"
                Padding="20,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Panel.ZIndex="11"
                Background="#C8151A22"
                BorderBrush="#4A5160"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed">
          <TextBlock x:Name="ViewerOsdText"
                     FontSize="19"
                     FontWeight="SemiBold"
                     Foreground="#F2F4F8" />
        </Border>
        </Grid>

        <!-- The split bar above the info panel: drag for any ratio, the
             chevrons step the pane between folded, split and whole column. -->
        <GridSplitter x:Name="ManagerInfoSplitter"
                      Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      AutomationProperties.Name="Resize the info panel"
                      Background="#303541"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      ToolTip="Drag to resize the info panel" />
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <Button x:Name="ManagerInfoExpandButton"
                  AutomationProperties.Name="Expand the info panel"
                  Content="˄"
                  Style="{StaticResource SplitBarChevronButtonStyle}"
                  ToolTip="Expand the info panel" />
          <Button x:Name="ManagerInfoCollapseButton"
                  Margin="4,0,0,0"
                  AutomationProperties.Name="Shrink the info panel"
                  Content="˅"
                  Style="{StaticResource SplitBarChevronButtonStyle}"
                  ToolTip="Shrink the info panel" />
        </StackPanel>

        <!-- Info panel -->
        <Border x:Name="InfoPanel"
                Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                DataContext="{Binding SelectedPhoto}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="10,6" Background="#1F232B">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#F2F4F8"
                           Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Path}" />
                <ToggleButton x:Name="InfoPanelToggle"
                              Grid.Column="1"
                              MinWidth="26"
                              Height="22"
                              Margin="8,0,0,0"
                              Padding="6,0"
                              AutomationProperties.Name="Show photo information"
                              Content="ⓘ"
                              IsChecked="True"
                              Style="{StaticResource EditorSelectToggleButtonStyle}"
                              ToolTip="Show or hide the information panel" />
              </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="10,8"
                    Visibility="{Binding IsChecked,
                                         ElementName=InfoPanelToggle,
                                         Converter={StaticResource BoolToVisibility}}">
              <ScrollViewer x:Name="ManagerInfoScroll"
                            VerticalScrollBarVisibility="Auto">
                <!-- Fills the pane, so the star-sized description row soaks
                     up whatever height the splitter grants; scrolls only
                     when even the minimum layout no longer fits. -->
                <Grid Margin="0,0,8,0"
                      MinHeight="{Binding ViewportHeight,
                                          ElementName=ManagerInfoScroll}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <controls:RatingPicker AutomationProperties.Name="Rating"
                                           RatingToolTipFormat="Set rating to {0}"
                                           ShowUnrated="True"
                                           UnratedToolTip="Clear rating"
                                           Value="{Binding Rating, Mode=TwoWay}" />
                    <StackPanel x:Name="LabelPickerPanel"
                                Margin="14,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" />
                    <Button MinWidth="30"
                            Height="24"
                            Margin="12,0,0,0"
                            Padding="6,0"
                            AutomationProperties.Name="Mark as picked"
                            Content="⚑"
                            FontFamily="Segoe UI Symbol"
                            Click="OnPickClick"
                            ToolTip="Mark as picked (P)" />
                    <Button MinWidth="30"
                            Height="24"
                            Margin="3,0,0,0"
                            Padding="6,0"
                            AutomationProperties.Name="Mark as rejected"
                            Content="⛌"
                            FontFamily="Segoe UI Symbol"
                            Click="OnRejectClick"
                            ToolTip="Mark as rejected (X)" />
                  </StackPanel>

                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource InfoCaptionStyle}"
                               Text="Taken" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource InfoValueStyle}"
                               Text="{Binding TakenAtText, TargetNullValue=—}" />

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource InfoCaptionStyle}"
                               Text="Camera" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Style="{StaticResource InfoValueStyle}"
                               Text="{Binding CameraText, TargetNullValue=—}"
                               ToolTip="{Binding CameraText}" />

                    <TextBlock Grid.Row="2"
                               Style="{StaticResource InfoCaptionStyle}"
                               Text="Lens" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Style="{StaticResource InfoValueStyle}"
                               Text="{Binding LensText, TargetNullValue=—}"
                               ToolTip="{Binding LensText}" />

                    <TextBlock Grid.Row="3"
                               Style="{StaticResource InfoCaptionStyle}"
                               Text="Exposure" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Style="{StaticResource InfoValueStyle}"
                               Text="{Binding ExposureText, TargetNullValue=—}" />

                    <TextBlock Grid.Row="4"
                               Style="{StaticResource InfoCaptionStyle}"
                               Text="Size" />
                    <StackPanel Grid.Row="4"
                                Grid.Column="1"
                                Orientation="Horizontal">
                      <TextBlock Style="{StaticResource InfoValueStyle}"
                                 Text="{Binding DimensionsText, TargetNullValue=—}" />
                      <TextBlock Margin="8,0,0,0"
                                 Style="{StaticResource InfoValueStyle}"
                                 Foreground="#9299A7"
                                 Text="{Binding FileSizeText}" />
                    </StackPanel>

                    <TextBlock Grid.Row="5"
                               Style="{StaticResource InfoCaptionStyle}"
                               Text="GPS" />
                    <StackPanel Grid.Row="5"
                                Grid.Column="1"
                                Orientation="Horizontal">
                      <TextBlock Style="{StaticResource InfoValueStyle}"
                                 Text="{Binding LocationText, TargetNullValue=—}" />
                      <Button Margin="8,0,0,0"
                              Padding="7,1"
                              AutomationProperties.Name="Open location in a map"
                              FontSize="11"
                              Click="OnOpenMapClick"
                              IsEnabled="{Binding HasLocation}"
                              ToolTip="{Binding MapToolTip}"
                              ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                          <!-- The verdict dot: green = nothing disputes the
                               position, amber = probably approximate, red =
                               probably far off. -->
                          <Ellipse Width="7"
                                   Height="7"
                                   Margin="0,1,5,0"
                                   VerticalAlignment="Center"
                                   Fill="{Binding LocationAccuracyBrush}"
                                   Visibility="{Binding HasLocation,
                                                        Converter={StaticResource BoolToVisibility}}" />
                          <TextBlock Text="Map" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>

                  <TextBlock Grid.Row="2"
                             Margin="0,10,0,3"
                             Style="{StaticResource InfoCaptionStyle}"
                             Text="Title" />
                  <TextBox Grid.Row="3"
                           Text="{Binding Title,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Grid.Row="4"
                             Margin="0,8,0,3"
                             Style="{StaticResource InfoCaptionStyle}"
                             Text="Description" />
                  <TextBox Grid.Row="5"
                           MinHeight="48"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalContentAlignment="Top"
                           VerticalScrollBarVisibility="Auto"
                           Text="{Binding Description,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Grid.Row="6"
                             Margin="0,8,0,3"
                             Style="{StaticResource InfoCaptionStyle}"
                             Text="Keywords (separate with ;)" />
                  <!-- Two lines minimum and wrapping, because AI keyword
                       harvests routinely overflow a single line. -->
                  <TextBox Grid.Row="7"
                           MinHeight="48"
                           TextWrapping="Wrap"
                           VerticalContentAlignment="Top"
                           VerticalScrollBarVisibility="Auto"
                           Text="{Binding Keywords,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Grid.Row="8"
                             Margin="0,8,0,3"
                             Style="{StaticResource InfoCaptionStyle}"
                             Text="People"
                             Visibility="{Binding PeopleText,
                                                  Converter={StaticResource NullToCollapsed}}" />
                  <ItemsControl Grid.Row="9"
                                ItemTemplate="{StaticResource PersonBadgeTemplate}"
                                ItemsSource="{Binding People}"
                                Visibility="{Binding PeopleText,
                                                     Converter={StaticResource NullToCollapsed}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <TextBlock Grid.Row="10"
                             Margin="0,8,0,3"
                             Style="{StaticResource InfoCaptionStyle}"
                             Text="Expression"
                             Visibility="{Binding ExpressionText,
                                                  Converter={StaticResource NullToCollapsed}}" />
                  <TextBlock Grid.Row="11"
                             FontSize="12"
                             Foreground="#C9CFDA"
                             Text="{Binding ExpressionText}"
                             TextWrapping="Wrap"
                             Visibility="{Binding ExpressionText,
                                                  Converter={StaticResource NullToCollapsed}}" />
                </Grid>
              </ScrollViewer>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="5"
                    HorizontalAlignment="Stretch"
                    Background="#303541"
                    DragCompleted="OnEditorSplitterDragCompleted" />

      <!-- Editor panel -->
      <Border x:Name="EditorPanel"
              Grid.Column="6"
              Background="{StaticResource PanelBrush}"
              BorderBrush="#303541"
              BorderThickness="1,0,0,0"
              DataContext="{Binding SelectedPhoto}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- The tabs and the info pane split the rest; the
                 SplitPaneController owns these heights. -->
            <RowDefinition x:Name="EditorTabsRow" Height="*" />
            <RowDefinition x:Name="EditorInfoSplitterRow" Height="13" />
            <RowDefinition x:Name="EditorInfoRow" Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Margin="10,10,10,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource SectionHeaderStyle}"
                         Text="HISTOGRAM" />
              <ComboBox x:Name="HistogramChannelBox"
                        Grid.Column="1"
                        Width="98"
                        Height="22"
                        Margin="0,0,0,4"
                        Padding="6,0"
                        AutomationProperties.Name="Histogram channel"
                        SelectionChanged="OnHistogramChannelChanged" />
            </Grid>
            <controls:HistogramView x:Name="Histogram" Height="96" />
            <TextBlock x:Name="ClippingText"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="#9299A7"
                       TextWrapping="Wrap" />
          </StackPanel>

          <TabControl Grid.Row="1" Margin="4,4,4,0">
            <TabItem Header="Light">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,8,10,12">
                  <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <Button MinWidth="78"
                            Margin="0,0,4,0"
                            Padding="8,4"
                            AutomationProperties.Name="Auto fix"
                            Command="{Binding Adjustments.AutoFixCommand}"
                            Content="Auto Fix"
                            ToolTip="Analyse this photo and apply a conservative correction" />
                    <Button MinWidth="60"
                            Margin="0,0,4,0"
                            Padding="8,4"
                            AutomationProperties.Name="Auto white balance"
                            Command="{Binding Adjustments.AutoWhiteBalanceCommand}"
                            Content="Auto WB"
                            ToolTip="Neutralize the colour cast" />
                    <ToggleButton x:Name="EyedropperButton"
                                  MinWidth="34"
                                  Height="27"
                                  Padding="6,0"
                                  AutomationProperties.Name="White balance eyedropper"
                                  Content="⌖"
                                  FontFamily="Segoe UI Symbol"
                                  Style="{StaticResource EditorSelectToggleButtonStyle}"
                                  ToolTip="Click a neutral grey area in the photo" />
                  </StackPanel>

                  <controls:AdjustmentSlider Label="Exposure"
                                             Minimum="-4"
                                             Maximum="4"
                                             ValueFormat="0.00"
                                             Value="{Binding Adjustments.Exposure, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Contrast"
                                             Value="{Binding Adjustments.Contrast, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Highlights"
                                             Value="{Binding Adjustments.Highlights, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Shadows"
                                             Value="{Binding Adjustments.Shadows, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Whites"
                                             Value="{Binding Adjustments.Whites, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Blacks"
                                             Value="{Binding Adjustments.Blacks, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Brightness"
                                             Value="{Binding Adjustments.Brightness, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Clarity"
                                             Value="{Binding Adjustments.Clarity, Mode=TwoWay}" />

                  <TextBlock Margin="0,12,0,4"
                             Style="{StaticResource SectionHeaderStyle}"
                             Text="COLOUR" />
                  <controls:AdjustmentSlider Label="Temperature"
                                             Value="{Binding Adjustments.Temperature, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Tint"
                                             Value="{Binding Adjustments.Tint, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Vibrance"
                                             Value="{Binding Adjustments.Vibrance, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Saturation"
                                             Value="{Binding Adjustments.Saturation, Mode=TwoWay}" />

                  <TextBlock Margin="0,12,0,4"
                             Style="{StaticResource SectionHeaderStyle}"
                             Text="LEVELS" />
                  <controls:AdjustmentSlider Label="Black point"
                                             Minimum="0"
                                             Maximum="254"
                                             Value="{Binding Adjustments.BlackPoint, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Midpoint"
                                             Minimum="0.2"
                                             Maximum="3"
                                             DefaultValue="1"
                                             ValueFormat="0.00"
                                             Value="{Binding Adjustments.MidPoint, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="White point"
                                             Minimum="1"
                                             Maximum="255"
                                             DefaultValue="255"
                                             Value="{Binding Adjustments.WhitePoint, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Gamma"
                                             Minimum="0.2"
                                             Maximum="3"
                                             DefaultValue="1"
                                             ValueFormat="0.00"
                                             Value="{Binding Adjustments.Gamma, Mode=TwoWay}" />

                  <Button Margin="0,12,0,0"
                          HorizontalAlignment="Right"
                          Command="{Binding Adjustments.ResetToneCommand}"
                          Content="Reset light and colour" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Detail">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,8,10,12">
                  <TextBlock Style="{StaticResource SectionHeaderStyle}"
                             Text="SHARPENING" />
                  <controls:AdjustmentSlider Label="Amount"
                                             Minimum="0"
                                             Maximum="200"
                                             Value="{Binding Adjustments.SharpenAmount, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Radius"
                                             Minimum="0.3"
                                             Maximum="6"
                                             DefaultValue="1"
                                             ValueFormat="0.0"
                                             Value="{Binding Adjustments.SharpenRadius, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Threshold"
                                             Minimum="0"
                                             Maximum="60"
                                             Value="{Binding Adjustments.SharpenThreshold, Mode=TwoWay}" />

                  <TextBlock Margin="0,12,0,4"
                             Style="{StaticResource SectionHeaderStyle}"
                             Text="NOISE REDUCTION" />
                  <controls:AdjustmentSlider Label="Luminance"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Adjustments.LuminanceNoiseReduction, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Colour"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Adjustments.ColorNoiseReduction, Mode=TwoWay}" />

                  <TextBlock Margin="0,12,0,4"
                             Style="{StaticResource SectionHeaderStyle}"
                             Text="LENS AND VIGNETTE" />
                  <controls:AdjustmentSlider Label="Vignette"
                                             Value="{Binding Adjustments.Vignette, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Devignette"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Adjustments.LensVignetting, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Distortion"
                                             Value="{Binding Adjustments.LensDistortion, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Fringing"
                                             Value="{Binding Adjustments.ChromaticAberration, Mode=TwoWay}" />

                  <Button Margin="0,12,0,0"
                          HorizontalAlignment="Right"
                          Command="{Binding Adjustments.ResetDetailCommand}"
                          Content="Reset detail" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Geometry">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,8,10,12">
                  <TextBlock Style="{StaticResource SectionHeaderStyle}"
                             Text="STRAIGHTEN" />
                  <controls:AdjustmentSlider Label="Angle"
                                             Minimum="-45"
                                             Maximum="45"
                                             ValueFormat="0.0"
                                             Value="{Binding Adjustments.StraightenAngle, Mode=TwoWay}" />
                  <TextBlock Margin="0,12,0,4"
                             Style="{StaticResource SectionHeaderStyle}"
                             Text="PERSPECTIVE" />
                  <controls:AdjustmentSlider Label="Vertical"
                                             Value="{Binding Adjustments.PerspectiveVertical, Mode=TwoWay}" />
                  <controls:AdjustmentSlider Label="Horizontal"
                                             Value="{Binding Adjustments.PerspectiveHorizontal, Mode=TwoWay}" />
                  <TextBlock Margin="0,10,0,0"
                             FontSize="11"
                             Foreground="#79808D"
                             Text="Straightening and keystone correction scale the frame up just enough that no empty corner is left behind."
                             TextWrapping="Wrap" />

                  <TextBlock Margin="0,14,0,4"
                             Style="{StaticResource SectionHeaderStyle}"
                             Text="CROP" />
                  <StackPanel x:Name="CropRatioPanel" />
                  <Button Margin="0,8,0,0"
                          HorizontalAlignment="Right"
                          Content="Clear crop"
                          Click="OnClearCropClick" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Layers">
              <Grid Margin="8,8,8,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource SectionHeaderStyle}"
                             Text="LAYERS" />
                  <ListBox x:Name="LayerList"
                           Grid.Row="1"
                           ItemContainerStyle="{StaticResource PanelListBoxItemStyle}"
                           SelectionChanged="OnLayerListSelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <CheckBox VerticalAlignment="Center"
                                    AutomationProperties.Name="Layer visible"
                                    IsChecked="{Binding IsVisible, Mode=OneWay}"
                                    Tag="{Binding Id}"
                                    Click="OnLayerVisibilityClick" />
                          <TextBlock Grid.Column="1"
                                     Margin="6,0,0,0"
                                     VerticalAlignment="Center"
                                     FontSize="12"
                                     Text="{Binding Name}"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                  <Button Margin="0,0,4,0"
                          Padding="9,4"
                          Content="Up"
                          Click="OnLayerMoveUpClick"
                          ToolTip="Bring the layer forward" />
                  <Button Margin="0,0,4,0"
                          Padding="9,4"
                          Content="Down"
                          Click="OnLayerMoveDownClick"
                          ToolTip="Send the layer back" />
                  <Button Margin="0,0,4,0"
                          Padding="9,4"
                          Content="Duplicate"
                          Click="OnLayerDuplicateClick" />
                  <Button Padding="9,4"
                          Content="Delete"
                          Click="OnLayerDeleteClick" />
                </WrapPanel>
              </Grid>
            </TabItem>
          </TabControl>

          <!-- The split bar above the editor's info pane, the same control
               the Manager column carries. -->
          <GridSplitter x:Name="EditorInfoSplitter"
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="Resize the info panel"
                        Background="#303541"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Rows"
                        ToolTip="Drag to resize the info panel" />
          <StackPanel Grid.Row="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
            <Button x:Name="EditorInfoExpandButton"
                    AutomationProperties.Name="Expand the info panel"
                    Content="˄"
                    Style="{StaticResource SplitBarChevronButtonStyle}"
                    ToolTip="Expand the info panel" />
            <Button x:Name="EditorInfoCollapseButton"
                    Margin="4,0,0,0"
                    AutomationProperties.Name="Shrink the info panel"
                    Content="˅"
                    Style="{StaticResource SplitBarChevronButtonStyle}"
                    ToolTip="Shrink the info panel" />
          </StackPanel>

          <!-- The same description-and-rating pane the Manager keeps at the
               bottom right, so a photograph can be rated and captioned
               without leaving the editor. -->
          <Border Grid.Row="3">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Padding="10,6" Background="#1F232B">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#F2F4F8"
                             Text="{Binding FileName}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Path}" />
                  <ToggleButton x:Name="EditorInfoToggle"
                                Grid.Column="1"
                                MinWidth="26"
                                Height="22"
                                Margin="8,0,0,0"
                                Padding="6,0"
                                AutomationProperties.Name="Show photo information"
                                Content="ⓘ"
                                IsChecked="True"
                                Style="{StaticResource EditorSelectToggleButtonStyle}"
                                ToolTip="Show or hide the information panel" />
                </Grid>
              </Border>

              <Border Grid.Row="1"
                      Padding="10,8"
                      Visibility="{Binding IsChecked,
                                           ElementName=EditorInfoToggle,
                                           Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer x:Name="EditorInfoScroll"
                              VerticalScrollBarVisibility="Auto">
                  <!-- Fills the pane, so the star-sized description row
                       soaks up whatever height the splitter grants. -->
                  <Grid Margin="0,0,8,0"
                        MinHeight="{Binding ViewportHeight,
                                            ElementName=EditorInfoScroll}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" MinHeight="48" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                      <controls:RatingPicker AutomationProperties.Name="Rating"
                                             RatingToolTipFormat="Set rating to {0}"
                                             ShowUnrated="True"
                                             UnratedToolTip="Clear rating"
                                             Value="{Binding Rating, Mode=TwoWay}" />
                      <StackPanel x:Name="EditorLabelPickerPanel"
                                  Margin="14,0,0,0"
                                  Orientation="Horizontal"
                                  VerticalAlignment="Center" />
                      <Button MinWidth="30"
                              Height="24"
                              Margin="12,0,0,0"
                              Padding="6,0"
                              AutomationProperties.Name="Mark as picked"
                              Content="⚑"
                              FontFamily="Segoe UI Symbol"
                              Click="OnPickClick"
                              ToolTip="Mark as picked (P)" />
                      <Button MinWidth="30"
                              Height="24"
                              Margin="3,0,0,0"
                              Padding="6,0"
                              AutomationProperties.Name="Mark as rejected"
                              Content="⛌"
                              FontFamily="Segoe UI Symbol"
                              Click="OnRejectClick"
                              ToolTip="Mark as rejected (X)" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock Style="{StaticResource InfoCaptionStyle}"
                                 Text="Taken" />
                      <TextBlock Grid.Column="1"
                                 Style="{StaticResource InfoValueStyle}"
                                 Text="{Binding TakenAtText, TargetNullValue=—}" />

                      <TextBlock Grid.Row="1"
                                 Style="{StaticResource InfoCaptionStyle}"
                                 Text="Camera" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource InfoValueStyle}"
                                 Text="{Binding CameraText, TargetNullValue=—}"
                                 ToolTip="{Binding CameraText}" />

                      <TextBlock Grid.Row="2"
                                 Style="{StaticResource InfoCaptionStyle}"
                                 Text="Lens" />
                      <TextBlock Grid.Row="2"
                                 Grid.Column="1"
                                 Style="{StaticResource InfoValueStyle}"
                                 Text="{Binding LensText, TargetNullValue=—}"
                                 ToolTip="{Binding LensText}" />

                      <TextBlock Grid.Row="3"
                                 Style="{StaticResource InfoCaptionStyle}"
                                 Text="Exposure" />
                      <TextBlock Grid.Row="3"
                                 Grid.Column="1"
                                 Style="{StaticResource InfoValueStyle}"
                                 Text="{Binding ExposureText, TargetNullValue=—}" />

                      <TextBlock Grid.Row="4"
                                 Style="{StaticResource InfoCaptionStyle}"
                                 Text="Size" />
                      <StackPanel Grid.Row="4"
                                  Grid.Column="1"
                                  Orientation="Horizontal">
                        <TextBlock Style="{StaticResource InfoValueStyle}"
                                   Text="{Binding DimensionsText, TargetNullValue=—}" />
                        <TextBlock Margin="8,0,0,0"
                                   Style="{StaticResource InfoValueStyle}"
                                   Foreground="#9299A7"
                                   Text="{Binding FileSizeText}" />
                      </StackPanel>

                      <TextBlock Grid.Row="5"
                                 Style="{StaticResource InfoCaptionStyle}"
                                 Text="GPS" />
                      <StackPanel Grid.Row="5"
                                  Grid.Column="1"
                                  Orientation="Horizontal">
                        <TextBlock Style="{StaticResource InfoValueStyle}"
                                   Text="{Binding LocationText, TargetNullValue=—}" />
                        <Button Margin="8,0,0,0"
                                Padding="7,1"
                                AutomationProperties.Name="Open location in a map"
                                FontSize="11"
                                Click="OnOpenMapClick"
                                IsEnabled="{Binding HasLocation}"
                                ToolTip="{Binding MapToolTip}"
                                ToolTipService.ShowOnDisabled="True">
                          <StackPanel Orientation="Horizontal">
                            <!-- The verdict dot: green = nothing disputes the
                                 position, amber = probably approximate, red =
                                 probably far off. -->
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,1,5,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding LocationAccuracyBrush}"
                                     Visibility="{Binding HasLocation,
                                                          Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="Map" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Margin="0,10,0,3"
                               Style="{StaticResource InfoCaptionStyle}"
                               Text="Title" />
                    <TextBox Grid.Row="3"
                             Text="{Binding Title,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="4"
                               Margin="0,8,0,3"
                               Style="{StaticResource InfoCaptionStyle}"
                               Text="Description" />
                    <TextBox Grid.Row="5"
                             MinHeight="48"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Description,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="6"
                               Margin="0,8,0,3"
                               Style="{StaticResource InfoCaptionStyle}"
                               Text="Keywords (separate with ;)" />
                    <!-- Two lines minimum and wrapping, because AI keyword
                         harvests routinely overflow a single line. -->
                    <TextBox Grid.Row="7"
                             MinHeight="48"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Keywords,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="8"
                               Margin="0,8,0,3"
                               Style="{StaticResource InfoCaptionStyle}"
                               Text="People"
                               Visibility="{Binding PeopleText,
                                                    Converter={StaticResource NullToCollapsed}}" />
                    <ItemsControl Grid.Row="9"
                                  ItemTemplate="{StaticResource PersonBadgeTemplate}"
                                  ItemsSource="{Binding People}"
                                  Visibility="{Binding PeopleText,
                                                       Converter={StaticResource NullToCollapsed}}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </Grid>
                </ScrollViewer>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#303541"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="PhotoScopeSection"
                    Width="130"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <TextBlock Width="101"
                     VerticalAlignment="Center"
                     Foreground="#C8CDD8"
                     Text="{Binding PhotoCountText}"
                     TextTrimming="CharacterEllipsis" />
          <Viewbox x:Name="FolderScopeIcon"
                   Width="20"
                   Height="18"
                   VerticalAlignment="Center"
                   ToolTip="{Binding FolderScopeToolTip}">
            <Grid Width="20" Height="18">
              <Path x:Name="FlatFolderIcon"
                    Data="M1.5,5 H7 L8.7,6.8 H18.5 V15.5 H1.5 Z"
                    Fill="Transparent"
                    Stroke="#C8CDD8"
                    StrokeThickness="1.35"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IncludeSubfolders}"
                                   Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
              <Path x:Name="RecursiveTreeIcon"
                    Data="M1.5,2.5 H6.5 V6.5 H1.5 Z
                          M12.5,1.5 H18.5 V5.5 H12.5 Z
                          M12.5,11.5 H18.5 V15.5 H12.5 Z
                          M6.5,4.5 H9.5 V13.5 H12.5
                          M9.5,4.5 H12.5"
                    Fill="Transparent"
                    Stroke="#C8CDD8"
                    StrokeThickness="1.25"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IncludeSubfolders}"
                                   Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Grid>
          </Viewbox>
        </StackPanel>

        <Border x:Name="StatusSeparator1"
                Grid.Column="1"
                Width="1"
                Height="18"
                Margin="10,0"
                Background="#3A3F4B" />

        <StackPanel x:Name="GalleryTotalsSection"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <TextBlock Margin="0,0,5,0"
                     VerticalAlignment="Center"
                     Foreground="#9299A7"
                     Text="Shown" />
          <TextBlock VerticalAlignment="Center"
                     Foreground="#C8CDD8"
                     Text="{Binding GalleryTotalsText}"
                     ToolTip="Files the current filter shows, and the disk they occupy" />
        </StackPanel>

        <Border x:Name="StatusSeparator2"
                Grid.Column="3"
                Width="1"
                Height="18"
                Margin="10,0"
                Background="#3A3F4B" />

        <StackPanel x:Name="SelectionTotalsSection"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <TextBlock Margin="0,0,5,0"
                     VerticalAlignment="Center"
                     Foreground="#9299A7"
                     Text="Selected" />
          <TextBlock VerticalAlignment="Center"
                     Foreground="#C8CDD8"
                     Text="{Binding SelectionTotalsText}"
                     ToolTip="Files selected in the gallery, and the disk they occupy" />
        </StackPanel>

        <Border x:Name="StatusSeparator3"
                Grid.Column="5"
                Width="1"
                Height="18"
                Margin="10,0"
                Background="#3A3F4B" />

        <TextBlock Grid.Column="6"
                   VerticalAlignment="Center"
                   Foreground="#9299A7"
                   Text="{Binding StatusText}"
                   TextTrimming="CharacterEllipsis" />

        <Border Grid.Column="7"
                Width="1"
                Height="18"
                Margin="10,0"
                Background="#3A3F4B" />

        <TextBlock Grid.Column="8"
                   VerticalAlignment="Center"
                   Foreground="#9299A7"
                   Text="1–5 rate · 6–9 label · P pick · X reject · Ctrl+B batch · Ctrl+K compare · Enter edits"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
