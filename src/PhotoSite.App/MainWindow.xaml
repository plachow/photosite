<Window x:Class="PhotoSite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PhotoSite.Controls"
        xmlns:viewModels="clr-namespace:PhotoSite.ViewModels"
        Title="PhotoSite"
        Icon="{StaticResource AppIcon}"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <Style x:Key="EditorToolButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="17" />
    </Style>

    <Style x:Key="EditorResetButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource EditorToolButtonStyle}">
      <Setter Property="Width" Value="Auto" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="EditorActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource EditorResetButtonStyle}">
      <Setter Property="MinWidth" Value="56" />
    </Style>

    <Style x:Key="EditorSelectToggleButtonStyle"
           TargetType="ToggleButton">
      <Setter Property="MinWidth" Value="62" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="#292D36" />
      <Setter Property="BorderBrush" Value="#454B57" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F2F4F8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ButtonChrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome"
                        Property="Background"
                        Value="#343A46" />
                <Setter TargetName="ButtonChrome"
                        Property="BorderBrush"
                        Value="#5D6675" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ButtonChrome"
                        Property="Background"
                        Value="#246A9B" />
                <Setter TargetName="ButtonChrome"
                        Property="BorderBrush"
                        Value="#8BC8FF" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ButtonChrome"
                        Property="Background"
                        Value="#2C78AC" />
                <Setter TargetName="ButtonChrome"
                        Property="BorderBrush"
                        Value="#B4DCFF" />
              </MultiTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonChrome"
                        Property="Background"
                        Value="#1D557D" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonChrome"
                        Property="BorderBrush"
                        Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.38" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PhotoContextMenuStyle"
           TargetType="ContextMenu">
      <Setter Property="Padding" Value="3" />
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="#4A5160" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F2F4F8" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
              <ItemsPresenter Margin="{TemplateBinding Padding}"
                              KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PhotoContextMenuItemStyle"
           TargetType="MenuItem">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="Foreground" Value="#F2F4F8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemBorder"
                    MinWidth="280"
                    Height="34"
                    Background="{TemplateBinding Background}"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  ContentSource="Icon" />
                <ContentPresenter Grid.Column="1"
                                  Margin="3,0,12,0"
                                  VerticalAlignment="Center"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="#AAB2C0"
                           Text="{TemplateBinding InputGestureText}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder"
                        Property="Background"
                        Value="#315676" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PhotoContextMenuSeparatorStyle"
           TargetType="Separator">
      <Setter Property="Height" Value="9" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1"
                    VerticalAlignment="Center"
                    Background="#4A5160"
                    SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <ContextMenu x:Key="PhotoFileContextMenu"
                 Style="{StaticResource PhotoContextMenuStyle}"
                 DataContext="{Binding PlacementTarget.Tag,
                                       RelativeSource={RelativeSource Self}}"
                 Opened="OnPhotoFileContextMenuOpened">
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Open in Editor"
                Click="OnOpenInEditorClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="17"
                     Foreground="#8BC8FF"
                     Text="✎" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator Style="{StaticResource PhotoContextMenuSeparatorStyle}" />
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Open in File Explorer"
                Click="OnShowInExplorerClick">
        <MenuItem.Icon>
          <Viewbox Width="17" Height="17">
            <Canvas Width="18" Height="18">
              <Path Data="M1.5,4.5 H7 L8.7,6.3 H16.5 V15.5 H1.5 Z"
                    Fill="#E8B84A"
                    Stroke="#FFE09A"
                    StrokeThickness="1"
                    StrokeLineJoin="Round" />
              <Path Data="M1.5,7 H16.5"
                    Stroke="#9B7628"
                    StrokeThickness="1" />
            </Canvas>
          </Viewbox>
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy filename"
                Click="OnCopyFileNameClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#D9E6F2"
                     Text="▤" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy full path"
                Click="OnCopyFullPathClick">
        <MenuItem.Icon>
          <Viewbox Width="17" Height="17">
            <Canvas Width="18" Height="18">
              <Path Data="M5.5,5.5 H15.5 V15.5 H5.5 Z"
                    Fill="#273E52"
                    Stroke="#8BC8FF"
                    StrokeThickness="1.4"
                    StrokeLineJoin="Round" />
              <Path Data="M2.5,12 V2.5 H12"
                    Stroke="#D9E6F2"
                    StrokeThickness="1.4"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </MenuItem.Icon>
      </MenuItem>
      <Separator Style="{StaticResource PhotoContextMenuSeparatorStyle}" />
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy image"
                InputGestureText="Ctrl+C"
                Click="OnCopyImageClick">
        <MenuItem.Icon>
          <Viewbox Width="17" Height="17">
            <Canvas Width="18" Height="18">
              <Path Data="M2.5,3.5 H15.5 V14.5 H2.5 Z"
                    Fill="#273E52"
                    Stroke="#8BC8FF"
                    StrokeThickness="1.3"
                    StrokeLineJoin="Round" />
              <Ellipse Canvas.Left="10.5"
                       Canvas.Top="5"
                       Width="2.4"
                       Height="2.4"
                       Fill="#FFD36A" />
              <Path Data="M4,12 L7.2,8.7 L9.6,11.1 L11.1,9.7 L14.2,12.8"
                    Stroke="#A8D88F"
                    StrokeThickness="1.3"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy to…"
                Click="OnCopyFileToClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#E8B84A"
                     Text="↗" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy to last destination"
                InputGestureText="Ctrl+Shift+C"
                Tag="LastCopyDestination"
                Visibility="Collapsed"
                Click="OnCopyFileToLastDestinationClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#8BC8FF"
                     Text="⇉" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>

    <ContextMenu x:Key="EditorContextMenu"
                 Style="{StaticResource PhotoContextMenuStyle}"
                 Opened="OnEditorContextMenuOpened">
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Select region"
                Tag="Select"
                Click="OnStartSelectionClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#8BC8FF"
                     Text="▧" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Crop selection"
                Tag="Crop"
                Click="OnCropSelectionClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#8BC8FF"
                     Text="⌗" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Copy to clipboard"
                Tag="Copy"
                Click="OnCopySelectionClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="16"
                     Foreground="#8BC8FF"
                     Text="⧉" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator Tag="SelectionActionsSeparator" />
      <MenuItem Padding="10,6"
                Style="{StaticResource PhotoContextMenuItemStyle}"
                Header="Clear selection"
                Tag="Clear"
                Click="OnClearSelectionClick">
        <MenuItem.Icon>
          <TextBlock FontFamily="Segoe UI Symbol"
                     FontSize="17"
                     Foreground="#C8CDD8"
                     Text="×" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition>
        <RowDefinition.Style>
          <Style TargetType="RowDefinition">
            <Setter Property="Height" Value="Auto" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEditorMode}" Value="True">
                <Setter Property="Height" Value="0" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsFullscreenMode}" Value="True">
                <Setter Property="Height" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </RowDefinition.Style>
      </RowDefinition>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavigatorColumn"
                          Width="260"
                          MinWidth="180" />
        <ColumnDefinition x:Name="NavigatorSplitterColumn" Width="5" />
        <ColumnDefinition x:Name="CatalogColumn"
                          Width="420"
                          MinWidth="280" />
        <ColumnDefinition x:Name="CatalogSplitterColumn" Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="#303541"
                BorderThickness="0,0,0,1"
                Padding="5,4">
          <StackPanel Orientation="Horizontal">
            <Button Width="30"
                    Height="30"
                    Margin="0,0,4,0"
                    Padding="0"
                    AutomationProperties.Name="Open folder"
                    Command="{Binding OpenFolderCommand}"
                    ToolTip="Open folder">
              <TextBlock VerticalAlignment="Center"
                         FontFamily="Segoe UI Emoji"
                         FontSize="15"
                         Text="📁" />
            </Button>
            <CheckBox Content="Recursive"
                      IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                      ToolTip="Scan the selected folder recursively" />
          </StackPanel>
        </Border>

        <TreeView x:Name="DirectoryTreeView"
                  Grid.Row="1"
                  Padding="4,8"
                  Background="{StaticResource PanelBrush}"
                  BorderThickness="0"
                  Foreground="#E4E7ED"
                  ItemsSource="{Binding DirectoryTree.Roots}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
        <TreeView.Resources>
          <Style TargetType="ScrollBar"
                 BasedOn="{StaticResource PaneScrollBarStyle}" />
          <HierarchicalDataTemplate DataType="{x:Type viewModels:DirectoryNodeViewModel}"
                                    ItemsSource="{Binding Children}">
            <Grid Margin="2,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         VerticalAlignment="Center"
                         FontFamily="Segoe UI Symbol, Segoe UI Emoji"
                         Foreground="#A9CFF2"
                         Text="{Binding Glyph}" />
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         Text="{Binding DisplayName}"
                         ToolTip="{Binding FullPath}" />
              <TextBlock Grid.Column="2"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="#79808D"
                         Text="…">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLoading}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </HierarchicalDataTemplate>
        </TreeView.Resources>
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#E4E7ED" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected"
                    Value="{Binding IsSelected, Mode=TwoWay}" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#284967" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="IsHitTestVisible" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TreeView.ItemContainerStyle>
        </TreeView>
      </Grid>

      <GridSplitter Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Background="#303541"
                    DragCompleted="OnPaneSplitterDragCompleted" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="#303541"
                BorderThickness="0,0,0,1"
                Padding="5,3">
          <StackPanel Orientation="Horizontal">
            <Button Margin="1"
                    Padding="9,4"
                    Command="{Binding SortByTakenAtCommand}"
                    Content="{Binding TakenAtSortLabel}"
                    ToolTip="Sort by date taken" />
            <Button Margin="1"
                    Padding="9,4"
                    Command="{Binding SortByFileNameCommand}"
                    Content="{Binding FileNameSortLabel}"
                    ToolTip="Sort by file name" />
            <Button Margin="1"
                    Padding="9,4"
                    Command="{Binding SortByRatingCommand}"
                    Content="{Binding RatingSortLabel}"
                    ToolTip="Sort by rating" />
          </StackPanel>
        </Border>

        <ListBox x:Name="PhotoList"
                 Grid.Row="1"
                 Background="{StaticResource PanelBrush}"
                 BorderThickness="0"
                 ItemsSource="{Binding Photos}"
                 SelectedItem="{Binding SelectedPhoto}"
                 MouseDoubleClick="OnPhotoListMouseDoubleClick"
                 PreviewMouseDown="OnPhotoListPreviewMouseDown"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.Resources>
          <Style TargetType="ScrollBar"
                 BasedOn="{StaticResource PhotoListScrollBarStyle}" />
        </ListBox.Resources>
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:VirtualizingTilePanel ItemWidth="204" ItemHeight="164" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Tag" Value="{Binding}" />
            <Setter Property="ContextMenu"
                    Value="{StaticResource PhotoFileContextMenu}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="#333844" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="116" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="#0C0E12" ClipToBounds="True">
                <controls:ThumbnailPresenter SourcePath="{Binding Path}"
                                             Stretch="UniformToFill" />
              </Border>
              <Grid Grid.Row="1" Margin="8,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#F2F4F8"
                           Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Path}" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FFD36A"
                           Text="{Binding RatingText}" />
              </Grid>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    Background="#303541"
                    DragCompleted="OnPaneSplitterDragCompleted" />

      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition>
            <RowDefinition.Style>
              <Style TargetType="RowDefinition">
                <Setter Property="Height" Value="0" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsEditorMode}" Value="True" />
                      <Condition Binding="{Binding IsFullscreenMode}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Height" Value="Auto" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </RowDefinition.Style>
          </RowDefinition>
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#303541"
                BorderThickness="0,0,0,1"
                Padding="6">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <ToggleButton x:Name="SelectRegionButton"
                          AutomationProperties.Name="Select image region"
                          Content="Select"
                          IsChecked="{Binding IsSelectionMode,
                                              ElementName=PreviewViewer,
                                              Mode=OneWay}"
                          Style="{StaticResource EditorSelectToggleButtonStyle}"
                          ToolTip="Select an image region (C)"
                          Click="OnSelectRegionClick" />
            <StackPanel x:Name="SelectionActionsPanel"
                        Margin="3,0,0,0"
                        Orientation="Horizontal">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasSelection,
                                                  ElementName=PreviewViewer}"
                                 Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Button x:Name="CropSelectionButton"
                      AutomationProperties.Name="Crop to selection"
                      Content="Crop"
                      Style="{StaticResource EditorActionButtonStyle}"
                      ToolTip="Crop to selection (Enter)"
                      Click="OnCropSelectionClick" />
              <Button x:Name="CopySelectionButton"
                      AutomationProperties.Name="Copy selection"
                      Content="Copy"
                      Style="{StaticResource EditorActionButtonStyle}"
                      ToolTip="Copy selection to clipboard (Ctrl+C)"
                      Click="OnCopySelectionClick" />
            </StackPanel>
            <Separator Margin="8,2" />
            <Button Content="Undo"
                    Style="{StaticResource EditorActionButtonStyle}"
                    ToolTip="Undo edit (Ctrl+Z)"
                    Command="{Binding SelectedPhoto.UndoEditCommand}" />
            <Button Content="Redo"
                    Style="{StaticResource EditorActionButtonStyle}"
                    ToolTip="Redo edit (Ctrl+Y)"
                    Command="{Binding SelectedPhoto.RedoEditCommand}" />
            <Separator Margin="8,2" />
            <Button AutomationProperties.Name="Rotate left"
                    Content="↶"
                    Style="{StaticResource EditorToolButtonStyle}"
                    ToolTip="Rotate left"
                    Command="{Binding SelectedPhoto.RotateLeftCommand}" />
            <Button AutomationProperties.Name="Rotate right"
                    Content="↷"
                    Style="{StaticResource EditorToolButtonStyle}"
                    ToolTip="Rotate right"
                    Command="{Binding SelectedPhoto.RotateRightCommand}" />
            <Button AutomationProperties.Name="Flip horizontally"
                    Content="⇋"
                    Style="{StaticResource EditorToolButtonStyle}"
                    ToolTip="Flip horizontally"
                    Command="{Binding SelectedPhoto.FlipHorizontalCommand}" />
            <Button AutomationProperties.Name="Reset all edits"
                    Content="Reset edits"
                    Style="{StaticResource EditorResetButtonStyle}"
                    ToolTip="Reset rotation, flip, and crop"
                    Command="{Binding SelectedPhoto.ResetEditsCommand}" />
            <Separator Margin="8,2" />
            <Button AutomationProperties.Name="Save current image as JPEG"
                    Content="Save as…"
                    Style="{StaticResource EditorActionButtonStyle}"
                    ToolTip="Save current image as (Ctrl+Shift+S)"
                    Click="OnSaveAsClick" />
            <Button AutomationProperties.Name="Upload current image to Imgur"
                    Content="Upload"
                    Style="{StaticResource EditorActionButtonStyle}"
                    ToolTip="Upload current image to Imgur and copy URL (Ctrl+U)"
                    Click="OnUploadToImgurClick" />
            <Separator Margin="8,2" />
            <TextBlock Margin="5,0"
                       VerticalAlignment="Center"
                       Foreground="#C8CDD8"
                       Text="Rating" />
            <controls:RatingPicker Margin="4,0,0,0"
                                   AutomationProperties.Name="Photo rating"
                                   RatingToolTipFormat="Set rating to {0}"
                                   ShowUnrated="False"
                                   UnratedToolTip="Clear rating"
                                   Value="{Binding SelectedPhoto.Rating,
                                                   Mode=TwoWay}" />
          </StackPanel>
        </Border>

        <controls:PhotoViewer x:Name="PreviewViewer"
                              Grid.Row="1"
                              SourcePath="{Binding SelectedPhoto.Path}"
                              SourceBitmap="{Binding SelectedPhoto.SourceBitmap}"
                              Tag="{Binding SelectedPhoto}"
                              ContextMenu="{StaticResource EditorContextMenu}"
                              ContextMenuOpening="OnPreviewContextMenuOpening"
                              EditRecipe="{Binding SelectedPhoto.EditRecipe}"
                              IsEditorMode="{Binding IsEditorMode}"
                              IsFullscreenMode="{Binding IsFullscreenMode}"
                              PreviousPhotoCommand="{Binding GuardedPreviousCommand,
                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                              NextPhotoCommand="{Binding GuardedNextCommand,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                              MiddleClickCommand="{Binding ToggleFullscreenCommand}"
                              DoubleClickCommand="{Binding GuardedToggleEditorCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}" />
      </Grid>
    </Grid>

    <Border Grid.Row="1"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#303541"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="PhotoScopeSection"
                    Width="130"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <TextBlock Width="101"
                     VerticalAlignment="Center"
                     Foreground="#C8CDD8"
                     Text="{Binding PhotoCountText}"
                     TextTrimming="CharacterEllipsis" />
          <Viewbox x:Name="FolderScopeIcon"
                   Width="20"
                   Height="18"
                   VerticalAlignment="Center"
                   ToolTip="{Binding FolderScopeToolTip}">
            <Grid Width="20" Height="18">
              <Path x:Name="FlatFolderIcon"
                    Data="M1.5,5 H7 L8.7,6.8 H18.5 V15.5 H1.5 Z"
                    Fill="Transparent"
                    Stroke="#C8CDD8"
                    StrokeThickness="1.35"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IncludeSubfolders}"
                                   Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
              <Path x:Name="RecursiveTreeIcon"
                    Data="M1.5,2.5 H6.5 V6.5 H1.5 Z
                          M12.5,1.5 H18.5 V5.5 H12.5 Z
                          M12.5,11.5 H18.5 V15.5 H12.5 Z
                          M6.5,4.5 H9.5 V13.5 H12.5
                          M9.5,4.5 H12.5"
                    Fill="Transparent"
                    Stroke="#C8CDD8"
                    StrokeThickness="1.25"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IncludeSubfolders}"
                                   Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Grid>
          </Viewbox>
        </StackPanel>

        <Border x:Name="StatusSeparator1"
                Grid.Column="1"
                Width="1"
                Height="18"
                Margin="10,0"
                Background="#3A3F4B" />

        <StackPanel x:Name="RatingFilterSection"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <TextBlock Margin="0,0,5,0"
                     VerticalAlignment="Center"
                     Foreground="#9299A7"
                     Text="Rating" />
          <controls:RatingPicker AutomationProperties.Name="Minimum rating filter"
                                 RatingToolTipFormat="At least {0} stars"
                                 UnratedToolTip="No rating filter"
                                 Value="{Binding MinimumRating, Mode=TwoWay}" />
        </StackPanel>

        <Border x:Name="StatusSeparator2"
                Grid.Column="3"
                Width="1"
                Height="18"
                Margin="10,0"
                Background="#3A3F4B" />

        <StackPanel Grid.Column="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <TextBlock Margin="0,0,5,0"
                     VerticalAlignment="Center"
                     Foreground="#9299A7"
                     Text="Search" />
          <TextBox x:Name="PhotoSearchBox"
                   Width="180"
                   Height="25"
                   Padding="6,3"
                   VerticalContentAlignment="Center"
                   Background="#111318"
                   BorderBrush="#4A5160"
                   Foreground="#F2F4F8"
                   SelectionBrush="{StaticResource AccentBrush}"
                   Text="{Binding SearchText,
                                  UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Border x:Name="StatusSeparator3"
                Grid.Column="5"
                Width="1"
                Height="18"
                Margin="10,0"
                Background="#3A3F4B" />

        <TextBlock Grid.Column="6"
                   VerticalAlignment="Center"
                   Foreground="#9299A7"
                   Text="{Binding StatusText}"
                   TextTrimming="CharacterEllipsis" />

        <Border Grid.Column="7"
                Width="1"
                Height="18"
                Margin="10,0"
                Background="#3A3F4B" />

        <TextBlock Grid.Column="8"
                   VerticalAlignment="Center"
                   Foreground="#9299A7"
                   Text="Wheel / arrows: navigate · Ctrl+wheel: zoom · 1–5: rating"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
