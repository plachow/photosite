<Window x:Class="PhotoSite.Dialogs.EditToolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tool"
        Background="{DynamicResource WindowBrush}"
        Foreground="#F2F4F8"
        Width="960"
        Height="660"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Presets and the preview switches sit in one strip above everything,
         the way every tool window of a photo editor is laid out. -->
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Margin="0,0,8,0"
                 VerticalAlignment="Center"
                 Foreground="#C8CDD8"
                 Text="Preset:" />
      <ComboBox x:Name="PresetBox"
                Grid.Column="1"
                Height="26"
                Padding="6,0"
                AutomationProperties.Name="Preset"
                DisplayMemberPath="Name"
                SelectionChanged="OnPresetSelectionChanged" />
      <Button x:Name="SavePresetButton"
              Grid.Column="2"
              MinWidth="34"
              Margin="6,0,0,0"
              Padding="8,2"
              AutomationProperties.Name="Save preset"
              Content="💾"
              FontFamily="Segoe UI Emoji"
              ToolTip="Save the current settings as a preset"
              Click="OnSavePresetClick" />
      <Button x:Name="DeletePresetButton"
              Grid.Column="3"
              MinWidth="34"
              Margin="4,0,0,0"
              Padding="8,2"
              AutomationProperties.Name="Delete preset"
              Content="🗑"
              FontFamily="Segoe UI Emoji"
              IsEnabled="False"
              ToolTip="Delete the selected preset"
              Click="OnDeletePresetClick" />
      <Button x:Name="ResetButton"
              Grid.Column="4"
              MinWidth="34"
              Margin="4,0,0,0"
              Padding="8,2"
              AutomationProperties.Name="Reset to defaults"
              Content="↺"
              FontFamily="Segoe UI Symbol"
              ToolTip="Back to the default settings"
              Click="OnResetClick" />
      <CheckBox x:Name="LivePreviewBox"
                Grid.Column="6"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="Preview"
                IsChecked="True"
                ToolTip="Render the settings live; turn off for a slow filter"
                Click="OnLivePreviewChanged" />
      <ToggleButton x:Name="GridButton"
                    Grid.Column="7"
                    MinWidth="52"
                    Margin="12,0,0,0"
                    Content="Grid"
                    Style="{StaticResource EditorSelectToggleButtonStyle}"
                    ToolTip="Overlay a grid to judge lines against"
                    Visibility="Collapsed"
                    Checked="OnGridToggled"
                    Unchecked="OnGridToggled" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="296" />
      </Grid.ColumnDefinitions>

      <Border Background="#0C0E12"
              BorderBrush="#303541"
              BorderThickness="1"
              CornerRadius="4">
        <Grid x:Name="PreviewHost"
              Background="Transparent"
              ClipToBounds="True"
              SizeChanged="OnPreviewHostSizeChanged"
              MouseWheel="OnPreviewMouseWheel"
              MouseLeftButtonDown="OnPreviewMouseDown"
              MouseMove="OnPreviewMouseMove"
              MouseLeftButtonUp="OnPreviewMouseUp">
          <Image x:Name="PreviewImage"
                 Margin="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Stretch="Uniform" />
          <Rectangle x:Name="GridOverlay"
                     Margin="1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Width="{Binding ActualWidth, ElementName=PreviewImage}"
                     Height="{Binding ActualHeight, ElementName=PreviewImage}"
                     Visibility="Collapsed">
            <Rectangle.Fill>
              <DrawingBrush TileMode="Tile"
                            Viewport="0,0,0.1,0.1"
                            ViewportUnits="RelativeToBoundingBox">
                <DrawingBrush.Drawing>
                  <GeometryDrawing Geometry="M0,0 L1,0 M0,0 L0,1">
                    <GeometryDrawing.Pen>
                      <Pen Brush="#8067B7FF" Thickness="0.02" />
                    </GeometryDrawing.Pen>
                  </GeometryDrawing>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Rectangle.Fill>
          </Rectangle>
          <TextBlock x:Name="PreviewBadge"
                     Margin="10"
                     Padding="7,2"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Background="#8C000000"
                     FontSize="11"
                     Foreground="#F2F4F8"
                     Text="AFTER" />
          <TextBlock x:Name="PreviewStatus"
                     Margin="10"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     FontSize="11"
                     Foreground="#9299A7" />
          <!-- Zoom: fit, steps, and 1:1 with the finished pixels, so
               sharpening and noise are judged on what the export holds
               rather than on the reduced fit preview. -->
          <Border Margin="8"
                  Padding="4,3"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Background="#B0111318"
                  BorderBrush="#4A5160"
                  BorderThickness="1"
                  CornerRadius="4">
            <StackPanel Orientation="Horizontal">
              <Button MinWidth="28"
                      Padding="6,1"
                      AutomationProperties.Name="Zoom out"
                      Content="−"
                      ToolTip="Zoom out"
                      Click="OnZoomOutClick" />
              <TextBlock x:Name="ZoomLabel"
                         MinWidth="64"
                         Margin="6,0"
                         VerticalAlignment="Center"
                         FontSize="11"
                         Foreground="#C8CDD8"
                         Text="Fit"
                         TextAlignment="Center" />
              <Button MinWidth="28"
                      Padding="6,1"
                      AutomationProperties.Name="Zoom in"
                      Content="+"
                      ToolTip="Zoom in"
                      Click="OnZoomInClick" />
              <Button MinWidth="44"
                      Margin="6,0,0,0"
                      Padding="6,1"
                      AutomationProperties.Name="Actual pixels"
                      Content="100 %"
                      ToolTip="One finished pixel per screen pixel"
                      Click="OnZoomActualClick" />
              <Button MinWidth="36"
                      Margin="4,0,0,0"
                      Padding="6,1"
                      AutomationProperties.Name="Fit to window"
                      Content="Fit"
                      ToolTip="The whole photograph"
                      Click="OnZoomFitClick" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Margin="10,0,0,0"
              Style="{StaticResource DialogPanelStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="SettingsHeader"
                     Style="{StaticResource SectionHeaderStyle}"
                     Text="SETTINGS" />
          <ScrollViewer Grid.Row="1"
                        Margin="0,0,-4,0"
                        Padding="0,0,4,0"
                        VerticalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="EditorHost" />
          </ScrollViewer>
          <StackPanel Grid.Row="2">
            <TextBlock x:Name="HintText"
                       Margin="0,10,0,0"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />
            <ToggleButton x:Name="BeforeButton"
                          Margin="0,10,0,0"
                          MinWidth="86"
                          HorizontalAlignment="Left"
                          Content="Before"
                          Style="{StaticResource EditorSelectToggleButtonStyle}"
                          ToolTip="Show the photograph as it was before this tool"
                          Checked="OnBeforeToggled"
                          Unchecked="OnBeforeToggled" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterText"
                 VerticalAlignment="Center"
                 FontSize="11"
                 Foreground="#9299A7" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="OkButton"
                MinWidth="96"
                Content="OK"
                IsDefault="True"
                Click="OnOkClick" />
        <Button MinWidth="96"
                Margin="8,0,0,0"
                Content="Cancel"
                IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
