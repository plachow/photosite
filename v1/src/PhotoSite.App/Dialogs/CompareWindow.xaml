<Window x:Class="PhotoSite.Dialogs.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare"
        Width="1400"
        Height="880"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        PreviewKeyDown="OnComparePreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="#303541"
            BorderThickness="0,0,0,1"
            Padding="8,5">
      <StackPanel Orientation="Horizontal">
        <TextBlock Margin="0,0,10,0"
                   VerticalAlignment="Center"
                   Foreground="#9299A7"
                   Text="Zoom" />
        <Button Margin="1,0"
                Padding="10,4"
                Content="Fit"
                Click="OnFitClick"
                ToolTip="Fit every photo to its pane (0)" />
        <Button Margin="1,0"
                Padding="10,4"
                Content="100 %"
                Click="OnActualSizeClick"
                ToolTip="Compare at 100 % (1)" />
        <CheckBox x:Name="SyncBox"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  Content="Synchronized pan and zoom"
                  IsChecked="True" />
        <Border Width="1"
                Height="18"
                Margin="14,0"
                Background="#3A3F4B" />
        <TextBlock VerticalAlignment="Center"
                   Foreground="#9299A7"
                   Text="1–5 rate · P pick · X reject · Del removes from the comparison · Esc closes" />
      </StackPanel>
    </Border>

    <UniformGrid x:Name="ViewerGrid"
                 Grid.Row="1"
                 Background="#0C0E12" />

    <Border Grid.Row="2"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#303541"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <TextBlock x:Name="StatusText"
                 Foreground="#9299A7"
                 TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
