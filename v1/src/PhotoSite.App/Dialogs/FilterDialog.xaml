<Window x:Class="PhotoSite.Dialogs.FilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PhotoSite.Controls"
        Title="Filters"
        Background="{DynamicResource WindowBrush}"
        Foreground="#F2F4F8"
        Width="880"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="252" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Margin="0,0,10,0" Style="{StaticResource DialogPanelStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="FILTER" />
        <ListBox x:Name="FilterList"
                 Grid.Row="1"
                 ItemContainerStyle="{StaticResource PanelListBoxItemStyle}"
                 SelectionChanged="OnFilterSelectionChanged" />
      </Grid>
    </Border>

    <Border Background="#0C0E12"
            BorderBrush="#303541"
            BorderThickness="1"
            CornerRadius="4"
            Grid.Column="1">
      <Grid>
        <Image x:Name="PreviewImage"
               Margin="1"
               RenderOptions.BitmapScalingMode="HighQuality"
               Stretch="Uniform" />
        <TextBlock x:Name="PreviewBadge"
                   Margin="10"
                   Padding="7,2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Background="#8C000000"
                   FontSize="11"
                   Foreground="#F2F4F8"
                   Text="AFTER" />
        <TextBlock x:Name="PreviewStatus"
                   Margin="10"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   FontSize="11"
                   Foreground="#9299A7" />
      </Grid>
    </Border>

    <Border Grid.Column="2"
            Margin="10,0,0,0"
            Style="{StaticResource DialogPanelStyle}">
      <StackPanel>
        <TextBlock x:Name="ParameterHeader"
                   Style="{StaticResource SectionHeaderStyle}"
                   Text="SETTINGS" />
        <controls:AdjustmentSlider x:Name="AmountSlider"
                                   Label="Amount"
                                   Minimum="0"
                                   Maximum="200" />
        <controls:AdjustmentSlider x:Name="RadiusSlider"
                                   Label="Radius"
                                   Minimum="0"
                                   Maximum="60"
                                   ValueFormat="0.0" />
        <controls:AdjustmentSlider x:Name="ThresholdSlider"
                                   Label="Threshold"
                                   Minimum="0"
                                   Maximum="80" />
        <TextBlock Margin="0,12,0,0"
                   FontSize="11"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Hold the Before button to see the unfiltered photo. The preview uses a reduced-size copy; the full image is filtered when you apply."
                   TextWrapping="Wrap" />
        <ToggleButton x:Name="BeforeButton"
                      Margin="0,10,0,0"
                      MinWidth="86"
                      HorizontalAlignment="Left"
                      Content="Before"
                      Style="{StaticResource EditorSelectToggleButtonStyle}" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button MinWidth="118"
              Content="Apply filter"
              IsDefault="True"
              Click="OnApplyClick" />
      <Button MinWidth="96"
              Margin="8,0,0,0"
              Content="Cancel"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
